{%- comment -%} Protokół Ocaleni — nowa strona główna (v3): wszystkie serie, najnowsze filmy, bestiariusz legend, gra, napiwki. Tryb ciemny/jasny. {%- endcomment -%}
{%- assign s = section.settings -%}
{%- assign tt = s.tiktok | default: 'https://www.tiktok.com/@protokolocaleni' -%}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script>try{var m=localStorage.getItem('po-theme');if(m)document.documentElement.setAttribute('data-po',m)}catch(e){}</script>
<style>
body>header.po-head,body>footer.po-foot,#b94-witaj{display:none!important}body{background:#0B0C0F}html[data-po=light] body{background:#EEF2F7}#MainContent{padding:0!important;margin:0!important;max-width:none!important}
#po{--bg:#0B0C0F;--card:#16171B;--card2:#1E1F24;--line:rgba(255,255,255,.07);--ink:#F2F3F5;--mut:#8B8F98;--acc:#E5484D;--accT:rgba(229,72,77,.14);--ok:#3DD68C;--r:24px;--rs:14px;
 font-family:Inter,system-ui,sans-serif;background:var(--bg);color:var(--ink);line-height:1.5;-webkit-font-smoothing:antialiased}
html[data-po=light] #po{--bg:#EEF2F7;--card:#FFFFFF;--card2:#F4F5F7;--line:#E6E8EC;--ink:#0E1116;--mut:#5B6270;--accT:rgba(229,72,77,.10)}
#po *{box-sizing:border-box}#po a{color:inherit;text-decoration:none}#po img{display:block;max-width:100%}
#po main{min-width:0}#po .app{display:grid;grid-template-columns:1fr;gap:20px;max-width:1440px;margin:0 auto;padding:16px}
@media(min-width:1100px){#po .app{grid-template-columns:240px 1fr;padding:20px}}
/* pasek boczny */
#po .side{position:fixed;inset:12px auto 12px 12px;width:260px;z-index:60;background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:20px 14px;display:flex;flex-direction:column;gap:6px;transform:translateX(-120%);transition:transform .2s}
#po .side.open{transform:none}
@media(min-width:1100px){#po .side{position:sticky;top:20px;height:calc(100vh - 40px);width:auto;transform:none;inset:auto}}
#po .logo{display:flex;align-items:center;gap:10px;padding:4px 8px 18px}#po .logo img{width:40px;height:40px;border-radius:12px;object-fit:cover}#po .logo b{font-weight:800;font-size:15px;letter-spacing:-.01em;line-height:1.1}#po .logo small{display:block;color:var(--mut);font-weight:500;font-size:12px}
#po .navh{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--mut);padding:14px 10px 6px}
#po .nav a{display:flex;align-items:center;gap:12px;height:42px;padding:0 12px;border-radius:12px;font-weight:500;font-size:14px;color:var(--mut);transition:background .15s,color .15s}
#po .nav a:hover{background:var(--card2);color:var(--ink)}#po .nav a.on{background:var(--card2);color:var(--ink);font-weight:600}
#po .nav svg,#po .ic svg{width:18px;height:18px;flex:none}
#po .side .foot{margin-top:auto;display:flex;gap:8px;padding:8px}
#po .ib{width:40px;height:40px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;background:var(--card2);border:1px solid var(--line);color:var(--ink);cursor:pointer}
#po .ib:hover{border-color:var(--mut)}#po .ib svg{width:18px;height:18px}
#po .scrim{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:55;display:none}#po .scrim.on{display:block}
/* górny pasek */
#po .top{display:flex;align-items:center;gap:10px;margin-bottom:20px}#po .top h1{font-size:15px;font-weight:600;margin:0;color:var(--mut)}#po .top .sp{flex:1}
#po .menu{display:inline-flex}@media(min-width:1100px){#po .menu{display:none}}
#po .pill{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:999px;font-weight:600;font-size:14px;border:1px solid var(--line);background:var(--card)}
#po .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:48px;padding:0 22px;border-radius:999px;font-weight:600;font-size:15px;border:0;cursor:pointer;transition:filter .15s}
#po .btn.p{background:var(--acc);color:#fff}#po .btn.p:hover{filter:brightness(1.08)}#po .btn.s{background:var(--card2);color:var(--ink);border:1px solid var(--line)}
#po a:focus-visible,#po button:focus-visible{outline:2px solid var(--acc);outline-offset:3px}
/* siatka bento */
#po .g{display:grid;grid-template-columns:repeat(12,1fr);gap:20px;margin-bottom:20px}
#po .c{background:var(--card);border:1px solid var(--line);border-radius:var(--r);padding:24px;min-width:0;position:relative;overflow:hidden}
#po .c8{grid-column:span 12}#po .c4,#po .c3,#po .c6,#po .c5,#po .c7{grid-column:span 12}
@media(min-width:700px){#po .c3,#po .c6{grid-column:span 6}#po .c4{grid-column:span 6}}
@media(min-width:1100px){#po .c8{grid-column:span 8}#po .c4{grid-column:span 4}#po .c3{grid-column:span 3}#po .c6{grid-column:span 6}#po .c5{grid-column:span 5}#po .c7{grid-column:span 7}}
#po .lbl{font-size:13px;font-weight:500;color:var(--mut)}#po h2{font-size:clamp(26px,3.2vw,34px);font-weight:700;letter-spacing:-.02em;line-height:1.1;margin:0}#po h3{font-size:17px;font-weight:600;margin:0;letter-spacing:-.01em}
#po .sec{display:flex;align-items:end;justify-content:space-between;gap:12px;margin:36px 0 16px}#po .sec p{margin:4px 0 0;color:var(--mut);font-size:14px}
#po .num{font-size:36px;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1.1;margin-top:8px}
#po .tag{display:inline-flex;align-items:center;height:26px;padding:0 10px;border-radius:999px;font-size:12px;font-weight:600;background:var(--card2);color:var(--mut)}#po .tag.new{background:var(--accT);color:var(--acc)}
/* hero */
#po .hero{display:grid;gap:24px;padding:32px;min-height:420px;align-content:end;background:var(--card)}
#po .hero .bgimg{position:absolute;inset:0;display:grid;grid-template-columns:repeat(6,1fr);opacity:.32;filter:blur(3px) saturate(.8)}
#po .hero .bgimg img{width:100%;height:100%;object-fit:cover}
#po .hero:before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(0deg,var(--card) 48%,rgba(0,0,0,.2) 100%)}
html[data-po=light] #po .hero .bgimg{opacity:.22}
#po .hero>*:not(.bgimg){position:relative;z-index:2}#po .hero>.tag{justify-self:start}
#po .hero h2{font-size:clamp(34px,5vw,56px);max-width:15ch}#po .hero p{margin:0;color:var(--mut);font-size:17px;max-width:56ch}
#po .row{display:flex;flex-wrap:wrap;gap:10px}
#po .cd{display:flex;gap:10px;margin-top:14px}#po .cd div{flex:1;background:var(--card2);border-radius:var(--rs);padding:14px 10px;text-align:center}#po .cd b{display:block;font-size:30px;font-weight:700;font-variant-numeric:tabular-nums}#po .cd small{color:var(--mut);font-size:12px}
/* serie */
#po .ser{display:flex;flex-direction:column;gap:14px;padding:0}#po .ser .im{aspect-ratio:16/10;overflow:hidden;background:var(--card2)}#po .ser .im img{width:100%;height:100%;object-fit:cover;transition:transform .3s}#po .ser:hover .im img{transform:scale(1.03)}
#po .ser .tx{padding:0 22px 22px;display:flex;flex-direction:column;gap:8px}#po .ser .tx p{margin:0;color:var(--mut);font-size:14px}
#po .ser.big .im{aspect-ratio:auto;height:300px;display:grid;grid-template-columns:repeat(6,1fr);gap:4px}#po .ser.big .im img{height:300px}
@media(max-width:699px){#po .ser.big .im{grid-template-columns:repeat(3,1fr);height:auto}#po .ser.big .im img{height:180px}}
#po .meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap}#po .more{margin-top:6px;font-weight:600;font-size:14px;display:inline-flex;gap:6px;align-items:center}
/* najnowsze */
#po .rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(180px,220px);gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:6px;scrollbar-width:thin}
#po .vid{scroll-snap-align:start;background:var(--card);border:1px solid var(--line);border-radius:20px;overflow:hidden;display:flex;flex-direction:column}
#po .vid .th{aspect-ratio:9/16;overflow:hidden;position:relative}#po .vid .th img{width:100%;height:100%;object-fit:cover}
#po .vid .th .tag{position:absolute;left:10px;top:10px;background:rgba(0,0,0,.65);color:#fff}
#po .vid .tx{padding:12px 14px 14px}#po .vid b{display:block;font-size:14px;font-weight:600;line-height:1.3}#po .vid small{color:var(--mut);font-size:12px}
/* bestiariusz */
#po .tbl{padding:8px 0}#po .tr{display:grid;grid-template-columns:48px 1fr auto;gap:14px;align-items:center;padding:10px 22px;min-height:64px}
#po .tr+.tr{border-top:1px solid var(--line)}#po .tr img{width:48px;height:48px;border-radius:12px;object-fit:cover}#po .tr b{font-weight:600;font-size:15px}#po .tr small{display:block;color:var(--mut);font-size:13px}
#po .lvl{display:flex;gap:3px}#po .lvl i{width:8px;height:20px;border-radius:3px;background:var(--card2)}#po .lvl i.on{background:var(--acc)}
#po .tr .ru{color:var(--mut);font-size:13px;display:none}@media(min-width:900px){#po .tr{grid-template-columns:48px 220px 1fr auto}#po .tr .ru{display:block}}
/* gra i napiwki */
#po .cta{background:var(--acc);color:#fff;border:0;display:flex;flex-direction:column;justify-content:space-between;gap:24px;min-height:300px}#po .cta h2{color:#fff}#po .cta p{margin:0;opacity:.9}#po .cta .btn{background:#fff;color:#0E1116;align-self:flex-start}
#po .amt{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:16px 0}#po .amt button{height:48px;border-radius:12px;border:1px solid var(--line);background:var(--card2);color:var(--ink);font:600 15px Inter,sans-serif;font-variant-numeric:tabular-nums;cursor:pointer}#po .amt button[aria-pressed=true]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
#po .tipbig{font-size:44px;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums}#po .buys{color:var(--mut);font-size:14px;min-height:21px}
#po .soc{display:flex;gap:8px;flex-wrap:wrap}#po .ftr{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;color:var(--mut);font-size:13px;padding:28px 4px 8px}
@media(prefers-reduced-motion:reduce){#po *{transition:none!important}}
</style>
{%- capture ic_home -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>{%- endcapture -%}
{%- capture ic_grid -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="2"/><rect x="14" y="3" width="7" height="5" rx="2"/><rect x="14" y="12" width="7" height="9" rx="2"/><rect x="3" y="16" width="7" height="5" rx="2"/></svg>{%- endcapture -%}
{%- capture ic_play -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="m10 9 5 3-5 3z"/></svg>{%- endcapture -%}
{%- capture ic_skull -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a8 8 0 0 0-8 8c0 2.5 1.2 4 3 5v3h10v-3c1.8-1 3-2.5 3-5a8 8 0 0 0-8-8z"/><circle cx="9" cy="11" r="1.5"/><circle cx="15" cy="11" r="1.5"/><path d="M10 19v2M14 19v2"/></svg>{%- endcapture -%}
{%- capture ic_pad -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="11" rx="5"/><path d="M7 11v3M5.5 12.5h3"/><circle cx="16" cy="11.5" r="1"/><circle cx="18" cy="13.5" r="1"/></svg>{%- endcapture -%}
{%- capture ic_heart -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 5.6a5 5 0 0 0-7.1 0L12 7.3l-1.7-1.7a5 5 0 1 0-7.1 7.1L12 21.5l8.8-8.8a5 5 0 0 0 0-7.1z"/></svg>{%- endcapture -%}
{%- capture ic_arrow -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture ic_tt -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.7a5.7 5.7 0 1 0 4.9 5.7V9.1a7.3 7.3 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-3.2-1.6z"/></svg>{%- endcapture -%}
{%- capture ic_yt -%}<svg viewBox="0 0 24 24" fill="currentColor"><path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12a31 31 0 0 0 .5 4.8 3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8zM9.8 15.1V8.9L15.2 12z"/></svg>{%- endcapture -%}
{%- capture ic_ig -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>{%- endcapture -%}
<div id="po">
<div class="scrim" id="poScrim"></div>
<div class="app">
  <aside class="side" id="poSide" aria-label="Nawigacja">
    <a class="logo" href="/"><img src="{{ 'blok94-awatar.jpg' | asset_url }}" alt="" width="40" height="40"><b>Protokół Ocaleni<small>Animowana groza po polsku</small></b></a>
    <nav class="nav">
      <a href="#start" class="on">{{ ic_home }}Start</a>
      <a href="#serie">{{ ic_grid }}Serie</a>
      <a href="#najnowsze">{{ ic_play }}Najnowsze</a>
      <a href="#legendy">{{ ic_skull }}Legendy</a>
      <div class="navh">Dla widzów</div>
      <a href="/pages/gra">{{ ic_pad }}Gra „Telefon o 2:00”</a>
      <a href="#wesprzyj">{{ ic_heart }}Wesprzyj kanał</a>
      <a href="/pages/kanal">{{ ic_grid }}Za kulisami</a>
      <a href="/pages/reklama">{{ ic_grid }}Współpraca</a>
    </nav>
    <div class="foot">
      <a class="ib" href="{{ tt }}" target="_blank" rel="noopener" aria-label="TikTok">{{ ic_tt }}</a>
      <a class="ib" href="{{ s.youtube }}" target="_blank" rel="noopener" aria-label="YouTube">{{ ic_yt }}</a>
      <a class="ib" href="{{ s.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">{{ ic_ig }}</a>
    </div>
  </aside>

  <main>
    <div class="top">
      <button class="ib menu" id="poMenu" aria-label="Menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
      <h1>Start</h1><span class="sp"></span>
      <button class="ib" id="poTheme" aria-label="Zmień tryb jasny / ciemny"><svg id="poSun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><svg id="poMoon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg></button>
      <a class="pill" href="{{ tt }}" target="_blank" rel="noopener">{{ ic_tt | replace: '<svg', '<svg width="16" height="16"' }}@protokolocaleni</a>
    </div>

    <section id="start" class="g">
      <div class="c c8 hero">
        <div class="bgimg" aria-hidden="true">
          {%- assign heroimgs = 'baba_jaga,wilkolak,zmora,utopiec,grupa_klasowa_4,prad_gasnie_o_3_v2' | split: ',' -%}{%- for n in heroimgs -%}<img src="{{ 'po-' | append: n | append: '.webp' | asset_url }}" alt="" loading="eager">{%- endfor -%}
        </div>
        <span class="tag new">Nowa seria · Polskie legendy grozy</span>
        <h2>Animowane historie grozy po polsku</h2>
        <p>Legendy ze słowiańskich wierzeń, nocne historie z bloku i dylematy, które mogą się przydarzyć każdemu. Każdy film kończy się czymś, przez co nie zaśniesz.</p>
        <div class="row"><a class="btn p" href="{{ tt }}" target="_blank" rel="noopener">Oglądaj na TikToku</a><a class="btn s" href="#serie">Zobacz wszystkie serie</a></div>
      </div>
      <div class="c c4">
        <div class="lbl">Następny film</div>
        <h3 style="margin-top:6px">Codziennie o 17:00 na TikToku</h3>
        <div class="cd" id="poCd" aria-live="polite"><div><b>--</b><small>godz.</small></div><div><b>--</b><small>min</small></div><div><b>--</b><small>sek.</small></div></div>
        <div class="lbl" style="margin-top:20px">Obserwujący</div>
        <div class="num">{{ s.followers }}</div>
        <div class="row" style="margin-top:10px"><span class="tag">{{ s.likes }} polubień</span><span class="tag">{{ s.videos }} filmów</span></div>
        <div class="lbl" style="margin-top:14px;font-size:12px">Dane z TikToka · {{ s.stats_date }}</div>
      </div>
    </section>

    <div class="sec" id="serie"><div><h2>Serie</h2><p>Pięć serii, jeden kanał. Każda ma inny rodzaj strachu.</p></div></div>
    <section class="g">
      <a class="c c8 ser big" href="{{ tt }}" target="_blank" rel="noopener">
        <div class="im">{%- assign legimgs = 'strzyga,bebok,utopiec,zmora,wilkolak,baba_jaga' | split: ',' -%}{%- for n in legimgs -%}<img src="{{ 'po-' | append: n | append: '.webp' | asset_url }}" alt="" loading="lazy">{%- endfor -%}</div>
        <div class="tx"><div class="meta"><span class="tag new">Nowe</span><span class="tag">6 legend</span></div><h3>Polskie legendy grozy</h3><p>Strzyga, Bebok, Utopiec, Zmora, Wilkołak i Baba Jaga. Prawdziwe wierzenia z polskich wsi i jedna noc, w której ktoś złamał zasadę.</p><span class="more">Oglądaj {{ ic_arrow }}</span></div>
      </a>
      <a class="c c4 ser" href="{{ tt }}" target="_blank" rel="noopener">
        <div class="im"><img src="{{ 'blok94-czesc7.jpg' | asset_url }}" alt="" loading="lazy"></div>
        <div class="tx"><div class="meta"><span class="tag">{{ s.views }} wyświetleń</span></div><h3>BLOK 94 · „Kto tam?”</h3><p>Ola zostaje sama na noc. Ktoś puka. Nie otwieraj.</p></div>
      </a>
      <a class="c c4 ser" href="{{ tt }}" target="_blank" rel="noopener">
        <div class="im"><img src="{{ 'po-grupa_klasowa_1.webp' | asset_url }}" alt="" loading="lazy"></div>
        <div class="tx"><div class="meta"><span class="tag">4 odcinki</span></div><h3>Grupa klasowa</h3><p>Nowy uczeń wysyła głosówki. Nikt go nigdy nie widział.</p></div>
      </a>
      <a class="c c4 ser" href="{{ tt }}" target="_blank" rel="noopener">
        <div class="im"><img src="{{ 'po-prad_gasnie_o_3_v2.webp' | asset_url }}" alt="" loading="lazy"></div>
        <div class="tx"><div class="meta"><span class="tag">Dylematy</span></div><h3>Co się stanie, gdy…?</h3><p>Jest trzecia w nocy. Masz jedną minutę. Co zrobisz?</p></div>
      </a>
      <a class="c c4 ser" href="{{ tt }}" target="_blank" rel="noopener">
        <div class="im"><img src="{{ 'po-sam_w_domu_2.webp' | asset_url }}" alt="" loading="lazy"></div>
        <div class="tx"><div class="meta"><span class="tag">2 odcinki</span></div><h3>Sam w domu</h3><p>Kuba zostaje sam. Ktoś ma klucze do jego mieszkania.</p></div>
      </a>
    </section>

    <div class="sec" id="najnowsze"><div><h2>Najnowsze filmy</h2><p>Przewiń, żeby zobaczyć więcej.</p></div><a class="btn s" href="{{ tt }}" target="_blank" rel="noopener">Wszystkie na TikToku</a></div>
    <div class="rail" tabindex="0" aria-label="Najnowsze filmy">
      {%- assign vids = 'baba_jaga|Baba Jaga|Polskie legendy grozy,wilkolak|Wilkołak|Polskie legendy grozy,zmora|Zmora|Polskie legendy grozy,utopiec|Utopiec|Polskie legendy grozy,bebok|Bebok|Polskie legendy grozy,strzyga|Strzyga|Polskie legendy grozy,prad_gasnie_o_3_v2|Prąd gaśnie o 3:00|Co się stanie, gdy…?,co_sie_stanie_gdy_1|Obcy ma klucze|Co się stanie, gdy…?,co_zrobisz_1|Obcy w aucie zna twoje imię|Co zrobisz?,grupa_klasowa_4|Grupa klasowa · odc. 4|Grupa klasowa' | split: ',' -%}
      {%- for v in vids -%}{%- assign p = v | split: '|' -%}
      <a class="vid" href="{{ tt }}" target="_blank" rel="noopener"><div class="th"><img src="{{ 'po-' | append: p[0] | append: '.webp' | asset_url }}" alt="" loading="lazy">{%- if forloop.index <= 3 -%}<span class="tag">Nowy</span>{%- endif -%}</div><div class="tx"><b>{{ p[1] }}</b><small>{{ p[2] }}</small></div></a>
      {%- endfor -%}
    </div>

    <div class="sec" id="legendy"><div><h2>Bestiariusz</h2><p>Stwory z naszych legend i zasady, które według wierzeń ratowały życie.</p></div></div>
    <section class="g">
      <div class="c c8 tbl">
        {%- assign bes = 'baba_jaga|Baba Jaga|Puszcza · chatka na kurzej nóżce|Nie jedz niczego w jej chatce.|5,wilkolak|Wilkołak|Leśne drogi · pełnia|Poznasz go po ludzkich oczach.|5,zmora|Zmora|Kamienica · trzecia w nocy|Zatkaj dziurkę od klucza.|4,utopiec|Utopiec|Stawy i rzeki|Nie wchodź do wody po zmroku.|4,strzyga|Strzyga|Wieś zimą · cmentarz|Nie otwieraj okna po zmroku.|5,bebok|Bebok|Strychy i kąty · Śląsk|Wracaj przed zmrokiem.|3' | split: ',' -%}
        {%- for b in bes -%}{%- assign p = b | split: '|' -%}{%- assign lv = p[4] | plus: 0 -%}
        <div class="tr"><img src="{{ 'po-' | append: p[0] | append: '.webp' | asset_url }}" alt="" loading="lazy"><div><b>{{ p[1] }}</b><small>{{ p[2] }}</small></div><div class="ru">{{ p[3] }}</div><div class="lvl" aria-label="Poziom zagrożenia {{ lv }} z 5">{%- for i in (1..5) -%}<i{% if i <= lv %} class="on"{% endif %}></i>{%- endfor -%}</div></div>
        {%- endfor -%}
      </div>
      <a class="c c4 cta" href="/pages/gra">
        <div><div class="lbl" style="color:rgba(255,255,255,.8)">Gra w przeglądarce</div><h2 style="margin-top:8px">„Telefon o 2:00”</h2><p style="margin-top:10px">Odbierasz, klikasz czy się rozłączasz? Sprawdź, czy przetrwasz noc w bloku 94.</p></div>
        <span class="btn">Zagraj {{ ic_arrow }}</span>
      </a>
    </section>

    <section class="g" id="wesprzyj">
      <div class="c c7">
        <div class="lbl">Wesprzyj kanał</div>
        <h2 style="margin-top:8px">Każdy film robimy sami</h2>
        <p style="color:var(--mut);margin:10px 0 0;max-width:56ch">Scenariusz, animacja, lektor i dźwięk powstają w naszym małym zespole. Napiwek to dobrowolne wsparcie, dzięki któremu kolejne legendy wychodzą szybciej. Nie dostajesz produktu, tylko nasze wielkie dzięki.</p>
        <div class="soc" style="margin-top:20px">
          <a class="pill" href="{{ tt }}" target="_blank" rel="noopener">{{ ic_tt | replace: '<svg', '<svg width="16" height="16"' }}TikTok</a>
          <a class="pill" href="{{ s.youtube }}" target="_blank" rel="noopener">{{ ic_yt | replace: '<svg', '<svg width="16" height="16"' }}YouTube</a>
          <a class="pill" href="{{ s.instagram }}" target="_blank" rel="noopener">{{ ic_ig | replace: '<svg', '<svg width="16" height="16"' }}Instagram</a>
        </div>
      </div>
      <div class="c c5">
        {%- assign tipp = s.tip_product -%}
        <div class="lbl">Wybierz kwotę</div>
        <div class="tipbig" id="poAmt">20 zł</div>
        <div class="buys" id="poBuys">= jedna scena z nową legendą</div>
        <div class="amt" id="poTips" data-tips='[{%- for tv in tipp.variants -%}{%- if tv.price >= 200 -%}{"id":{{ tv.id }},"p":{{ tv.price }}},{%- endif -%}{%- endfor -%}{}]'></div>
        <a class="btn p" id="poTipBtn" href="#" style="width:100%">Daję napiwek</a>
        <div class="lbl" style="margin-top:10px;font-size:12px;text-align:center">BLIK, karta, Apple Pay, Google Pay, PayPal</div>
      </div>
    </section>

    <div class="ftr"><span>© {{ 'now' | date: '%Y' }} Protokół Ocaleni · historie i postacie są fikcyjne</span><span class="soc"><a href="/policies/privacy-policy">Polityka prywatności</a></span></div>
  </main>
</div>
</div>
<script>
(function(){var R=document.documentElement,po=document.getElementById('po');var wd=document.getElementById('b94-witaj');if(wd&&wd.open)wd.close();setTimeout(function(){var w=document.getElementById('b94-witaj');if(w&&w.open)w.close()},600);
 function setT(m){R.setAttribute('data-po',m);document.getElementById('poSun').style.display=m==='light'?'none':'';document.getElementById('poMoon').style.display=m==='light'?'':'none';try{localStorage.setItem('po-theme',m)}catch(e){}}
 var cur=R.getAttribute('data-po')||'dark';setT(cur);
 document.getElementById('poTheme').onclick=function(){setT(R.getAttribute('data-po')==='light'?'dark':'light')};
 var side=document.getElementById('poSide'),scr=document.getElementById('poScrim');function tog(o){side.classList.toggle('open',o);scr.classList.toggle('on',o)}
 document.getElementById('poMenu').onclick=function(){tog(!side.classList.contains('open'))};scr.onclick=function(){tog(false)};side.querySelectorAll('a[href^="#"]').forEach(function(a){a.addEventListener('click',function(){tog(false)})});
 // podświetlenie aktywnej sekcji
 var links=[].slice.call(side.querySelectorAll('.nav a[href^="#"]'));var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){links.forEach(function(l){l.classList.toggle('on',l.getAttribute('href')==='#'+e.target.id)})}})},{rootMargin:'-40% 0px -55% 0px'});['start','serie','najnowsze','legendy','wesprzyj'].forEach(function(id){var el=document.getElementById(id);if(el)io.observe(el)});
 // odliczanie do 17:00 czasu polskiego
 function next(){var now=Date.now(),f=new Intl.DateTimeFormat('en-CA',{timeZone:'Europe/Warsaw',year:'numeric',month:'2-digit',day:'2-digit'}),hf=new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Warsaw',hour:'2-digit',hourCycle:'h23'});for(var d=0;d<3;d++){var q=f.format(new Date(now+d*864e5)).split('-'),g=Date.UTC(+q[0],+q[1]-1,+q[2],17,0,0),h=parseInt(hf.format(new Date(g)),10)%24,t=g-(h-17)*36e5;if(t>now)return t}return now+864e5}
 var T=next(),cd=document.getElementById('poCd').querySelectorAll('b');function tick(){var ms=T-Date.now();if(ms<=0)T=next(),ms=T-Date.now();var x=Math.floor(ms/1e3);cd[0].textContent=String(Math.floor(x/3600)).padStart(2,'0');cd[1].textContent=String(Math.floor(x%3600/60)).padStart(2,'0');cd[2].textContent=String(x%60).padStart(2,'0')}tick();setInterval(tick,1000);
 // napiwki: warianty produktu „napiwek”, link /cart/ID:1 jak dotąd
 var box=document.getElementById('poTips'),vs=[];try{vs=JSON.parse(box.dataset.tips).filter(function(v){return v.id})}catch(e){}
 var B={200:'= minuta dźwięku grozy',500:'= nowy potwór w bestiariuszu',1000:'= jedna zła odpowiedź Południcy',2000:'= jedna scena z nową legendą',5000:'= cały lektor do filmu',10000:'= nowa legenda szybciej'};
 var fmt=function(p){return (p/100).toLocaleString('pl-PL',{maximumFractionDigits:2})+' zł'};
 function pick(k){var v=vs[k];[].forEach.call(box.children,function(b,j){b.setAttribute('aria-pressed',j===k?'true':'false')});document.getElementById('poAmt').textContent=fmt(v.p);document.getElementById('poBuys').textContent=B[v.p]||'= kolejne sekundy animacji';var bt=document.getElementById('poTipBtn');bt.textContent='Daję napiwek · '+fmt(v.p);bt.href='/cart/'+v.id+':1'}
 vs.forEach(function(v,k){var b=document.createElement('button');b.type='button';b.textContent=fmt(v.p);b.onclick=function(){pick(k)};box.appendChild(b)});
 if(vs.length){var d=0;vs.forEach(function(v,k){if(v.p===2000)d=k});pick(d)}else{document.getElementById('poTipBtn').href='/cart'}
})();
</script>
