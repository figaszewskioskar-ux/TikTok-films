      <div class="floors" role="group" aria-label="Kwota napiwku" id="floors" data-tips='[{%- for tv in tipp.variants -%}{%- if tv.price >= 200 -%}{"id":{{ tv.id }},"p":{{ tv.price }}},{%- endif -%}{%- endfor -%}{}]'></div>
