<script>
// odliczanie do premiery: pon. 9.11.2026, 1:30 czasu polskiego (00:30 UTC)
(function(){const T=Date.parse(document.getElementById('cd').dataset.t);const p=n=>String(n).padStart(2,'0');
 const set=(id,v,l)=>{const e=document.getElementById(id);if(e)e.innerHTML=v+'<i>'+l+'</i>';};
 function tick(){let s=Math.max(0,Math.floor((T-Date.now())/1000));set('cd-d',Math.floor(s/86400),'dni');set('cd-h',p(Math.floor(s%86400/3600)),'godz.');set('cd-m',p(Math.floor(s%3600/60)),'min');set('cd-s',p(s%60),'sek.');}
 tick();setInterval(tick,1000);})();
// napiwki: przyciski windy = warianty produktu „napiwek” (te same co wcześniej), link /cart/ID:1 jak dotąd
(function(){const box=document.getElementById('floors');if(!box)return;let vs=[];try{vs=JSON.parse(box.dataset.tips).filter(v=>v.id&&v.p>=200).sort((a,b)=>a.p-b.p);}catch(e){}if(!vs.length)return;
 const B={200:'= jedna linijka lektora',500:'= jeden efekt dźwiękowy',1000:'= jeden dymek z głosem',2000:'= jedna scena z Kapturem',5000:'= cała noc w bloku 94',10000:'= połowa nowej części'};
 const fmt=c=>{const z=c/100;return (z%1?z.toFixed(2).replace('.',','):String(z))+' zł';};
 const amt=document.getElementById('t-amt'),buys=document.getElementById('t-buys'),btn=document.getElementById('t-btn');
 let start=vs.findIndex(v=>v.p===2000);if(start<0)start=Math.min(3,vs.length-1);
 function pick(k){const v=vs[k];box.querySelectorAll('button').forEach((x,j)=>x.setAttribute('aria-pressed',j===k?'true':'false'));amt.textContent=fmt(v.p);buys.textContent=B[v.p]||'= kolejne sekundy animacji';btn.textContent='Daję napiwek · '+fmt(v.p);btn.href='/cart/'+v.id+':1';}
 vs.forEach((v,k)=>{const b=document.createElement('button');b.type='button';b.innerHTML=(v.p/100)+'<small>zł</small>';b.addEventListener('click',()=>pick(k));box.appendChild(b);});
 pick(start);})();
// quiz
(function(){const Q=[
 {q:'2:47 w nocy. Ktoś puka, a wizjer jest czarny. Co robisz?',o:['Pytam „kto tam?”','Nie odzywam się i dzwonię na 112','Otwieram na łańcuch'],ok:1,w:'Cisza mówi, że nikogo nie ma. Pytanie zdradza, że jesteś w domu.'},
 {q:'Ktoś krzyczy zza drzwi: „Policja! Otwierać!”. Co robisz?',o:['Otwieram, to przecież policja','Pytam 112, czy patrol jest pod moim adresem','Krzyczę, żeby pokazali legitymację przez wizjer'],ok:1,w:'Dyspozytor wie, gdzie są radiowozy. Fałszywy policjant tego nie przewidzi.'},
 {q:'Nocą pisze do ciebie konto bez zdjęcia: „jesteś sama?”. Co robisz?',o:['Odpisuję: kim jesteś?','Robię zrzut ekranu, blokuję i zgłaszam','Wysyłam mu zdjęcie z okna'],ok:1,w:'Nie rozmawiaj z obcym. Zachowaj dowód, zablokuj i zgłoś.'}];
 let i=0;const qt=document.getElementById('q-text'),qo=document.getElementById('q-opts'),qw=document.getElementById('q-why'),qn=document.getElementById('q-no'),nx=document.getElementById('q-next');
 function show(){const c=Q[i];qt.textContent=c.q;qo.innerHTML='';qw.textContent='';nx.hidden=true;qn.textContent='Pytanie '+(i+1)+' z '+Q.length;
  c.o.forEach((t,k)=>{const b=document.createElement('button');b.type='button';b.textContent=t;b.addEventListener('click',()=>{qo.querySelectorAll('button').forEach((x,j)=>{x.disabled=true;if(j===c.ok)x.classList.add('ok');});if(k!==c.ok)b.classList.add('bad');qw.textContent=(k===c.ok?'Dobrze. ':'Tak zrobiła Ola i to był błąd. ')+c.w;nx.hidden=false;nx.textContent=i<Q.length-1?'Następne pytanie':'Od początku';});qo.appendChild(b);});}
 nx.addEventListener('click',()=>{i=(i+1)%Q.length;show();});show();})();
</script>

