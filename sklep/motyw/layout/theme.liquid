<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
  {%- assign b94_desc = 'BLOK 94 · „Kto tam?” – animowana seria grozy z TikToka @protokolocaleni. Wszystkie części, gra i zasady bezpieczeństwa, które mogą uratować także ciebie.' -%}
  {%- if page_description != blank and request.page_type != 'index' -%}{%- assign b94_desc = page_description -%}{%- endif -%}
  <meta name="description" content="{{ b94_desc | escape }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">{%- else -%}<link rel="icon" href="{{ 'logo_kwadrat.png' | asset_url }}">{%- endif -%}
  {%- assign b94_title = page_title -%}{%- if request.page_type == 'index' -%}{%- assign b94_title = 'BLOK 94 · Kto tam? Nie otwieraj!' -%}{%- endif -%}
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ b94_title | escape }}">
  <meta property="og:description" content="{{ b94_desc | escape }}">
  <meta property="og:image" content="https:{{ 'blok94-og.jpg' | asset_url }}">
  <meta property="og:image:secure_url" content="https:{{ 'blok94-og.jpg' | asset_url }}">
  <meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="BLOK 94 · Kto tam? Nie otwieraj! Ola i Kaptur pod blokiem nocą">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ b94_title | escape }}">
  <meta name="twitter:description" content="{{ b94_desc | escape }}">
  <meta name="twitter:image" content="https:{{ 'blok94-og.jpg' | asset_url }}">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Public+Sans:wght@400;500;600;700&display=swap">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'po-extra.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'po-extra.js' | asset_url }}" defer></script>
  <style>
    .po-sup{display:inline-flex;align-items:center;gap:6px;background:#d7263d;color:#fff;font-weight:800;font-size:14px;line-height:1;padding:10px 14px;border-radius:999px;text-decoration:none;box-shadow:0 6px 16px rgba(215,38,61,.35);white-space:nowrap}
    .po-sup:hover{filter:brightness(1.08)}
    .po-sup:focus-visible{outline:3px solid #f39c12;outline-offset:3px}
    .po-ico{display:flex;align-items:center;gap:10px}
    @media(max-width:420px){.po-sup{padding:9px 11px;font-size:13px}.po-play .pl-t{display:none}}
    /* nagłówek i stopka: spokojniej, jeden język przycisków */
    html body .po-sup{border-radius:10px;box-shadow:none;font-weight:700}
    html body .po-foot .b94s a,html body .po-foot a[class*="tt"],html body .po-foot a[class*="yt"],html body .po-foot a[class*="ig"]{background:transparent!important;background-image:none!important;color:#f3efe6!important;border:1px solid rgba(243,239,230,.18)!important;box-shadow:none!important;border-radius:10px!important}
  </style>
  {{ content_for_header }}
</head>
<body>
  <header class="po-head">
    <div class="po-w">
      <a class="po-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {%- if settings.logo != blank -%}<img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="160" height="64">
        {%- else -%}<span class="po-lg">Protokół<b>Ocaleni</b></span>{%- endif -%}
      </a>
      <nav class="po-nav" aria-label="Menu">
        {%- assign menu = linklists['main-menu'] -%}
        {%- if menu and menu.links.size > 0 -%}
          {%- for link in menu.links -%}{%- if link.url contains 'poradnik' or link.title contains 'Poradnik' -%}{%- continue -%}{%- endif -%}<a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{%- if link.url == routes.root_url -%}BLOK 94{%- elsif link.url contains 'nasz-kanal' -%}Za kulisami{%- else -%}{{ link.title | escape }}{%- endif -%}</a>{%- endfor -%}<a href="/pages/akta"{% if page.handle == 'akta' %} aria-current="page"{% endif %}>Akta sprawy</a>
        {%- else -%}
          <a href="{{ routes.root_url }}">Poradnik</a><a href="/pages/reklama-na-kanale">Reklama na kanale</a>
        {%- endif -%}
      </nav>
      <div class="po-ico">
        <a class="po-sup" href="{{ routes.root_url }}#wesprzyj" aria-label="Wesprzyj kanał napiwkiem"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.8 4.5c2.1 0 3.6 1.1 4.4 2.6.8-1.5 2.3-2.6 4.4-2.6 3.8 0 5.9 3.9 4.4 7.3C19.5 16.4 12 21 12 21z"/></svg><span>Wesprzyj</span></a>
        <a class="po-play" href="/pages/gra" aria-label="Zagraj w grę Kto tam?" title="Zagraj w grę"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" x2="10" y1="11" y2="11"/><line x1="8" x2="8" y1="9" y2="13"/><line x1="15" x2="15.01" y1="12" y2="12"/><line x1="18" x2="18.01" y1="10" y2="10"/><path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59c-.006.052-.01.101-.017.152C2.604 9.416 2 14.456 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.414-1.414A2 2 0 0 1 9.828 16h4.344a2 2 0 0 1 1.414.586L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.545-.604-6.584-.685-7.258-.007-.05-.011-.1-.017-.151A4 4 0 0 0 17.32 5z"/></svg><span class="pl-t">Graj</span></a>
        <a class="po-cart" href="{{ routes.cart_url }}" aria-label="Koszyk{% if cart.item_count > 0 %}, produkty: {{ cart.item_count }}{% endif %}" title="Koszyk"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3h3l2.6 12.2a1.6 1.6 0 0 0 1.6 1.3h8.4a1.6 1.6 0 0 0 1.6-1.2L21.5 7H6.3"/></svg>{% if cart.item_count > 0 %}<span>{{ cart.item_count }}</span>{% endif %}</a>
      </div>
    </div>
  </header>
  <main id="MainContent">{{ content_for_layout }}</main>
  {%- render 'blok94-witaj' -%}
  <footer class="po-foot">
    <div class="po-w" style="padding-bottom:18px">{% render 'blok94-social', title: 'Obserwuj BLOK 94' %}</div>
    <div class="po-w">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }} · <a href="https://www.tiktok.com/@protokolocaleni" target="_blank" rel="noopener">TikTok</a> · <a href="https://www.youtube.com/@protokolocaleni" target="_blank" rel="noopener">YouTube</a></span>
      <span class="po-pay">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'po-pi' }}{%- endfor -%}</span><span class="po-pol">{%- for policy in shop.policies -%}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{%- endfor -%}</span>
    </div>
  </footer>
  {{ 'po-design.css' | asset_url | stylesheet_tag }}
</body>
</html>
