.b94-akta .akta-code b{color:#f5c542}
.b94-akta .btn{display:flex;align-items:center;justify-content:center;min-height:50px;border-radius:14px;font-weight:800;border:0;cursor:pointer;background:#d7263d;color:#fff}
</style>
<script>
(function(){var k=document.getElementById('b94-kaptur'),d=document.getElementById('b94-akta');if(!k||!d)return;var n=0,t=0;
 function hit(){var now=Date.now();n=(now-t<1500)?n+1:1;t=now;k.classList.remove('shake');void k.offsetWidth;k.classList.add('shake');
  if(n>=3){n=0;try{d.showModal();}catch(e){d.setAttribute('open','');}}}
 k.addEventListener('click',hit);k.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();hit();}});
 var v=document.getElementById('b94-akta-v');document.getElementById('b94-akta-x').addEventListener('click',function(){d.close?d.close():d.removeAttribute('open');});
 d.addEventListener('close',function(){if(v)v.pause();});
 d.addEventListener('click',function(e){if(e.target===d&&d.close)d.close();});})();
</script>

