{%- comment -%} BLOK 94 – strona główna w stylu serii „Kto tam?” (Kuba, Ola, Kaptur). {%- endcomment -%}
<style>
/* Układ: nocna klatka schodowa — kolejne „piętra” strony od wejścia (baner) po wyjście (stopka). Jeden, nocny wygląd. */
#b94{

  --night:#0a0c14; --stair:#131726; --wall:#1b2034; --ink:#f3efe6; --muted:#aeb0c2;
  --sign:#d7263d; --hat:#f39c12; --ola:#7b4fc9; --door:#5e4029; --door2:#4d3420; --gold:#c9a15a; --led:#ff3b30; --metal:#9aa1a8;
  --display:"Big Shoulders Display","Arial Narrow",Impact,sans-serif; --body:"Public Sans",system-ui,-apple-system,"Segoe UI",sans-serif; --mono:"JetBrains Mono",ui-monospace,"Courier New",monospace;
}#b94 .wrap{max-width:1120px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}#b94 h1,#b94 h2,#b94 h3{font-family:var(--display);font-weight:400;line-height:1.02;text-wrap:balance;margin:0}#b94 h2{font-size:clamp(30px,6vw,48px)}#b94 .eyebrow{display:inline-block;font:800 12px/1 var(--body);letter-spacing:.14em;text-transform:uppercase;color:#14161b;background:var(--hat);padding:7px 12px;border-radius:999px}#b94 .sign{display:inline-block;background:var(--sign);color:#fff;padding:.04em .28em .1em;border-radius:.18em;transform:rotate(-1.5deg);box-shadow:0 10px 30px rgba(215,38,61,.35)}#b94 section{padding-block:72px}#b94 .lead{color:var(--muted);font-size:clamp(17px,2.2vw,19px);max-width:60ch}#b94 .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:14px 22px;border-radius:14px;font:800 16px/1 var(--body);text-decoration:none;letter-spacing:.02em;border:0;cursor:pointer}#b94 .btn.red{background:var(--sign);color:#fff;box-shadow:0 10px 26px rgba(215,38,61,.4)}#b94 .btn.line{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 2px rgba(243,239,230,.35)}#b94 .btn:focus-visible,#b94 button:focus-visible,#b94 a:focus-visible{outline:3px solid var(--hat);outline-offset:3px}

/* baner */
#b94 .hero{padding-block:40px 64px;background:radial-gradient(900px 500px at 70% 10%,#1d2747 0%,transparent 60%)}#b94 .hero .wrap{display:grid;gap:32px;align-items:center}#b94 .hero h1{font-size:clamp(54px,12vw,112px);margin:16px 0 18px}#b94 .hero .story{font-size:clamp(18px,2.4vw,21px);max-width:44ch}#b94 .hero .cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}#b94 .hero figure{margin:0;border-radius:24px;overflow:hidden;box-shadow:0 40px 80px rgba(0,0,0,.6);position:relative;max-width:520px;justify-self:center;width:100%}#b94 .hero figure figcaption{position:absolute;left:16px;bottom:16px;font:800 13px/1.3 var(--body);background:rgba(10,12,20,.8);padding:8px 12px;border-radius:10px}#b94 .next{margin-top:26px;display:flex;flex-wrap:wrap;align-items:center;gap:14px;background:var(--stair);border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:14px 16px;max-width:560px}#b94 .next .lbl{font-weight:800;font-size:14px}#b94 .next .lbl small{display:block;color:var(--muted);font-weight:600}#b94 .cd{display:flex;gap:6px;font-family:var(--mono);font-variant-numeric:tabular-nums}#b94 .cd span{background:#0d0f13;color:var(--led);text-shadow:0 0 12px rgba(255,59,48,.6);border-radius:8px;padding:8px 8px 6px;font-size:22px;min-width:52px;text-align:center}#b94 .cd span i{display:block;font:600 10px/1 var(--body);color:#9a8f8f;font-style:normal;text-shadow:none;margin-top:3px}#b94 .stats{display:flex;flex-wrap:wrap;gap:22px;margin-top:22px;color:var(--muted);font-size:15px}#b94 .stats b{display:block;color:var(--ink);font-family:var(--display);font-size:28px}@media(min-width:900px){#b94 .hero .wrap{grid-template-columns:1.15fr .85fr}}

/* części serii */
#b94 .parts{background:var(--stair)}#b94 .parts .head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:16px;margin-bottom:28px}#b94 .grid4{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px}#b94 .part{background:var(--wall);border-radius:18px;overflow:hidden;display:flex;flex-direction:column;min-width:0}#b94 .part img{aspect-ratio:4/5;object-fit:cover;width:100%}#b94 .part .in{padding:16px 16px 18px;display:flex;flex-direction:column;gap:8px;flex:1}#b94 .part .no{font:800 12px/1 var(--body);letter-spacing:.12em;text-transform:uppercase;color:var(--hat)}#b94 .part h3{font-size:22px}#b94 .part p{margin:0;color:var(--muted);font-size:15px}#b94 .part .rule{margin-top:auto;font-size:14px;font-weight:600;background:rgba(215,38,61,.12);border-left:4px solid var(--sign);padding:8px 10px;border-radius:6px}#b94 .part a{margin-top:8px;font-weight:800;font-size:15px;color:var(--ink)}

/* bohaterowie */
#b94 .cast{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;margin-top:28px}#b94 .who{background:linear-gradient(180deg,#232a44,#161a2a);border-radius:18px;padding:18px 16px;text-align:center}#b94 .who img{height:200px;width:auto;margin:0 auto 6px;object-fit:contain}#b94 .who h3{font-size:22px}#b94 .who .tag{display:inline-block;font:800 11px/1 var(--body);letter-spacing:.1em;text-transform:uppercase;margin:8px 0;padding:5px 8px;border-radius:6px;color:#14161b}#b94 .who p{margin:0;color:var(--muted);font-size:15px}

/* zasady: wizjer */
#b94 .rules{background:radial-gradient(700px 400px at 20% 0%,#2a1d14 0%,transparent 70%)}#b94 .rlist{list-style:none;padding:0;margin:28px 0 0;display:grid;gap:12px}#b94 .rlist li{display:grid;grid-template-columns:56px 1fr;gap:14px;align-items:center;background:var(--stair);border-radius:16px;padding:14px 16px}#b94 .peep{width:56px;height:56px;border-radius:50%;background:#000;box-shadow:0 0 0 6px var(--gold),inset 0 0 12px rgba(255,255,255,.08)}#b94 .rlist b{display:block;font-size:17px}#b94 .rlist span{color:var(--muted);font-size:15px}#b94 .n112{font-family:var(--mono);color:var(--led)}

/* quiz */
#b94 .quiz{background:var(--stair)}#b94 .qbox{margin-top:24px;background:var(--wall);border-radius:20px;padding:20px;max-width:720px}#b94 .qbox .q{font-weight:800;font-size:19px;margin:0 0 14px}#b94 .qbox .opts{display:grid;gap:10px}#b94 .qbox button{all:unset;cursor:pointer;background:#0f1220;border-radius:12px;padding:14px 16px;font-weight:600;box-shadow:inset 0 0 0 2px rgba(255,255,255,.08)}#b94 .qbox button.ok{box-shadow:inset 0 0 0 2px #30a46c;background:#10261a}#b94 .qbox button.bad{box-shadow:inset 0 0 0 2px var(--sign);background:#2a1016}#b94 .qbox .why{margin:14px 0 0;color:var(--muted);min-height:24px}#b94 .qbox .foot{display:flex;justify-content:space-between;align-items:center;margin-top:12px;font-size:14px;color:var(--muted)}

/* napiwki: panel windy */
#b94 .sup{padding-block:72px;background:radial-gradient(1200px 600px at 50% -10%,#1b2340 0%,var(--night) 60%)}#b94 .sup .w{display:grid;gap:28px}#b94 .tipcard{position:relative;border-radius:22px;padding:22px;overflow:hidden;max-width:520px;width:100%;justify-self:center;
 background:radial-gradient(circle,var(--gold) 2.2px,transparent 2.6px) 0 0/44px 44px,repeating-linear-gradient(45deg,transparent 0 30px,var(--door2) 30px 32px),repeating-linear-gradient(-45deg,transparent 0 30px,var(--door2) 30px 32px),var(--door);
 box-shadow:0 30px 60px rgba(0,0,0,.5),inset 0 0 0 10px #3c2a1c}#b94 .chars{display:flex;justify-content:space-between;align-items:flex-end;margin:-6px -6px -22px;pointer-events:none}#b94 .chars img{width:30%;max-width:150px;filter:drop-shadow(0 10px 20px rgba(0,0,0,.6))}#b94 .chars .bubble{background:#fff;color:#14161b;font-weight:700;font-size:13px;padding:8px 12px;border-radius:14px;border:2px dashed #2a2d35;margin-bottom:120px;max-width:44%}#b94 .panel{background:linear-gradient(180deg,#a9b1ba,#8c939c);border-radius:16px;padding:18px;box-shadow:inset 0 2px 0 rgba(255,255,255,.4),0 10px 30px rgba(0,0,0,.4)}#b94 .plate{display:flex;justify-content:space-between;align-items:center;font:800 11px/1 var(--body);letter-spacing:.1em;color:#2b2f36;margin-bottom:10px}#b94 .plate b{background:#2f5da8;color:#fff;padding:5px 8px;border-radius:6px}#b94 .led{background:#0d0f13;border-radius:12px;padding:14px 16px;text-align:center;box-shadow:inset 0 0 0 3px #1c1f26}#b94 .led .amount{font-family:var(--mono);font-weight:700;font-size:56px;color:var(--led);text-shadow:0 0 18px rgba(255,59,48,.7);font-variant-numeric:tabular-nums}#b94 .led .buys{margin:4px 0 0;color:#ffb3ad;font-size:13px;min-height:18px}#b94 .floors{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:18px 10px 8px}#b94 .floors button{aspect-ratio:1;border-radius:50%;border:0;cursor:pointer;font:900 18px/1 var(--body);color:#2b2f36;background:radial-gradient(circle at 35% 30%,#f4f6f8,#c9cdd2 60%,#9ea4ab);box-shadow:0 4px 0 #6e757c,0 6px 14px rgba(0,0,0,.35);max-width:96px;justify-self:center;width:100%}#b94 .floors button small{display:block;font-size:10px;font-weight:700;opacity:.7;margin-top:2px}#b94 .floors button[aria-pressed=true]{color:#fff;background:radial-gradient(circle at 35% 30%,#ffd27a,#f39c12 60%,#c97a0a);box-shadow:0 2px 0 #8a5306,0 0 22px rgba(243,156,18,.75);transform:translateY(2px)}#b94 .tipbtn{width:100%;margin-top:14px;font-size:18px;text-transform:uppercase}#b94 .payic{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin-top:14px;opacity:.85}#b94 .payic span{background:#fff;color:#111;font:800 10px/1 var(--body);padding:5px 7px;border-radius:5px}#b94 small.note{display:block;text-align:center;color:#e9dccb;opacity:.85;font-size:12px;margin-top:10px}#b94 .uses{list-style:none;padding:0;margin:0;display:grid;grid-template-columns:repeat(2,1fr);gap:10px}#b94 .uses li{background:linear-gradient(180deg,#8e959c,#767d84);border-radius:8px;padding:14px 12px 12px;color:#14161b;font-weight:800;font-size:14px;position:relative;box-shadow:inset 0 -3px 0 rgba(0,0,0,.2);min-width:0}#b94 .uses li:before{content:"";display:block;height:6px;width:60%;background:#5c6369;border-radius:3px;margin-bottom:10px}#b94 .uses li span{display:block;font-size:11px;font-weight:700;color:#1f2a3a;opacity:.75;margin-top:4px;text-transform:uppercase;letter-spacing:.08em}#b94 .uses li em{position:absolute;top:8px;right:10px;font-style:normal;font-size:11px;background:#2f5da8;color:#fff;padding:2px 6px;border-radius:4px}@media(min-width:900px){#b94 .sup .w{grid-template-columns:1fr 1fr;align-items:start}#b94 .uses{grid-column:1/-1;grid-template-columns:repeat(4,1fr)}}@media (prefers-reduced-motion:no-preference){#b94 .part,#b94 .who{transition:transform .2s}#b94 .part:hover,#b94 .who:hover{transform:translateY(-4px)}}

#b94{background:var(--night);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.55}
#b94 *{box-sizing:border-box}#b94 a{color:inherit}#b94 img{max-width:100%;display:block}
.po-nav a[href*="poradnik"],.po-nav a[href*="72h"]{display:none}

#b94 .stats{display:grid;grid-template-columns:repeat(4,auto);justify-content:start;column-gap:26px;row-gap:6px}
#b94 .stats small{grid-column:1/-1;color:var(--muted);font-size:12px;opacity:.75}
#b94 .yt{margin:12px 0 0;color:var(--muted);font-size:15px}#b94 .yt a{color:var(--ink);font-weight:700}
#b94 .swipe{display:none}
@media(max-width:760px){
 #b94 section{padding-block:48px}
 #b94 .hero{padding-block:28px 40px}
 #b94 .hero h1{margin:12px 0 12px}
 #b94 .hero .cta{display:grid;grid-template-columns:1fr 1fr;gap:10px}
 #b94 .hero .cta .btn{width:100%;padding-inline:12px}
 #b94 .hero figure{max-height:340px;border-radius:18px}
 #b94 .hero figure img{height:340px;width:100%;object-fit:cover;object-position:50% 30%}
 #b94 .next{flex-direction:column;align-items:flex-start;width:100%}
 #b94 .cd{width:100%;justify-content:space-between}#b94 .cd span{flex:1;min-width:0;font-size:20px}
 #b94 .stats{grid-template-columns:repeat(2,1fr);column-gap:16px;row-gap:14px}
 #b94 .stats b{font-size:26px}
 #b94 .grid4{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:14px;margin-inline:calc(-1*max(16px,env(safe-area-inset-left,0px)));padding-inline:max(16px,env(safe-area-inset-left,0px));padding-bottom:8px;scrollbar-width:none}
 #b94 .grid4::-webkit-scrollbar{display:none}
 #b94 .part{flex:0 0 80%;scroll-snap-align:start}
 #b94 .swipe{display:block;margin:6px 0 0;font-weight:700;font-size:14px;color:var(--hat)}
 #b94 .cast{grid-template-columns:1fr 1fr;gap:12px}
 #b94 .who{padding:14px 10px}#b94 .who img{height:130px}#b94 .who h3{font-size:20px}#b94 .who p{font-size:13.5px}
 #b94 .rlist li{grid-template-columns:40px 1fr;gap:12px;padding:12px 14px}#b94 .peep{width:40px;height:40px;box-shadow:0 0 0 5px var(--gold)}
 #b94 .rlist b{font-size:16px}
 #b94 .qbox{padding:16px}
 #b94 .tipcard{padding:16px}
 #b94 .floors{gap:12px;margin:16px 4px 6px}
 #b94 .led .amount{font-size:48px}
 #b94 .uses{grid-template-columns:1fr 1fr}
 #b94 h2{font-size:34px}
}
#b94 .part{position:relative}#b94 .hot{position:absolute;top:12px;left:12px;background:var(--sign);color:#fff;font:800 13px/1 var(--body);padding:8px 10px;border-radius:999px;box-shadow:0 6px 18px rgba(215,38,61,.5)}
#b94 section{scroll-margin-top:130px}
#b94 .pdf{display:flex;flex-wrap:wrap;align-items:center;gap:12px 18px;margin-top:22px}#b94 .pdf p{margin:0;color:var(--muted);font-size:15px;max-width:40ch}
</style>
<div id="b94">
<section class="hero"><div class="wrap">
  <div>
    <span class="eyebrow">Nowa seria · @protokolocaleni</span>
    <h1><span class="sign">Kto tam?</span></h1>
    <p class="story">Druga czterdzieści siedem. Ola jest sama w mieszkaniu 94. Ktoś puka, a wizjer jest czarny. Animowana historia z jednego bloku i prawdziwe zasady, które mogą uratować także ciebie.</p>
    <div class="cta"><a class="btn red" href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">Oglądaj na TikToku</a><a class="btn line" href="#seria">Wszystkie części</a></div><p class="yt">Całe filmy także na <a href="{{ section.settings.youtube }}" target="_blank" rel="noopener">YouTube</a></p>
    <div class="next" aria-label="Kolejna część">
      <div class="lbl">Nowa część<small>{{ section.settings.premiere_label }}</small></div>
      <div class="cd" id="cd" data-t="{{ section.settings.premiere }}"><span id="cd-d">0<i>dni</i></span><span id="cd-h">00<i>godz.</i></span><span id="cd-m">00<i>min</i></span><span id="cd-s">00<i>sek.</i></span></div>
    </div>
    {% render 'blok94-powiadom', id: 'hero' %}
    <div class="stats" aria-label="Kanał @protokolocaleni na TikToku"><div><b>{{ section.settings.followers }}</b>obserwujących</div><div><b>{{ section.settings.likes }}</b>polubień</div><div><b>{{ section.settings.views }}</b>wyświetleń części 2</div><div><b>{{ section.settings.videos }}</b>filmów</div><small>Stan kanału: {{ section.settings.stats_date }}</small></div>
  </div>
  <figure><img src="{{ 'blok94-hero.jpg' | asset_url }}" alt="Blok nocą, w oknie na 9. piętrze pali się światło, pod blokiem stoi postać w kapturze" width="1080" height="1350"><figcaption>Kasztanowa 12 · klatka II · 9. piętro</figcaption></figure>
</div></section>

<section class="parts" id="seria"><div class="wrap">
  <div class="head"><div><span class="eyebrow">Seria</span><h2 style="margin-top:12px">Oglądaj od początku</h2></div><p class="lead" style="margin:0">Każda część kończy się cliffhangerem. Zacznij od pierwszej.</p><p class="swipe" aria-hidden="true">Przesuń, żeby zobaczyć kolejne →</p></div>
  <div class="grid4">
    <article class="part"><img src="{{ 'blok94-czesc1.jpg' | asset_url }}" alt="Okładka części 1: Nie pytaj kto tam" loading="lazy" width="720" height="900"><div class="in"><span class="no">Część 1</span><h3>Nie pytaj „kto tam?”</h3><p>Ktoś zakleił wizjer. Za drzwiami płacze kobieta, a piętro wyżej ktoś czeka.</p><div class="rule">Prośba o pomoc w nocy? Nie otwieraj, dzwoń na 112.</div><a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">Oglądaj →</a></div></article>
    <article class="part"><img src="{{ 'blok94-czesc2.jpg' | asset_url }}" alt="Okładka części 2: Nie otwieraj policji" loading="lazy" width="720" height="900"><div class="in"><span class="no">Część 2</span><span class="hot">{{ section.settings.views }} wyświetleń</span><h3>Nie otwieraj „policji”!</h3><p>Ktoś wali do drzwi: „Policja!”. Prawdziwy patrol jest jeszcze cztery minuty dalej.</p><div class="rule">Zapytaj 112, czy patrol stoi pod twoimi drzwiami.</div><a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">Oglądaj →</a></div></article>
    {%- if section.settings.parts >= 3 -%}<article class="part"><img src="{{ 'blok94-czesc3.jpg' | asset_url }}" alt="Okładka części 3: Nie wychodź do licznika" loading="lazy" width="720" height="900"><div class="in"><span class="no">Część 3</span><h3>Nie wychodź do licznika!</h3><p>O północy prąd gaśnie tylko w mieszkaniu 94. Kuba idzie włączyć korki.</p><div class="rule">Prąd zgasł tylko u ciebie? Nie wychodź na korytarz.</div><a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">Oglądaj →</a></div></article>{%- endif -%}
    {%- if section.settings.parts >= 4 -%}<article class="part"><img src="{{ 'blok94-czesc4.jpg' | asset_url }}" alt="Okładka części 4: Nie czekaj do rana" loading="lazy" width="720" height="900"><div class="in"><span class="no">Część 4</span><h3>Nie czekaj do rana!</h3><p>Kaptur ma klucze Kuby. O 3:12 zamek przekręca się sam.</p><div class="rule">Zgubione klucze? Zamek wymień tej samej nocy.</div><a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">Oglądaj →</a></div></article>{%- endif -%}
  </div>
</div></section>

<section id="bohaterowie"><div class="wrap">
  <span class="eyebrow">Bohaterowie</span><h2 style="margin-top:12px">Mieszkańcy bloku 94</h2>
  <p class="lead" style="margin:10px 0 0">Kto jest Kapturem? Wszystkie poszlaki zebraliśmy w <a href="/pages/akta" style="color:var(--hat);font-weight:800">aktach sprawy →</a></p>
  <div class="cast">
    <div class="who"><img src="{{ 'blok94-ola.png' | asset_url }}" alt="Ola" loading="lazy"><h3>Ola</h3><span class="tag" style="background:#b79bea">mieszkanie 94</span><p>Została sama na noc. Uczy się na błędach szybciej, niż by chciała.</p></div>
    <div class="who"><img src="{{ 'blok94-kuba.png' | asset_url }}" alt="Kuba" loading="lazy"><h3>Kuba</h3><span class="tag" style="background:var(--hat)">brat Oli</span><p>{%- if section.settings.parts >= 3 -%}Gra w słuchawkach, gubi klucze i zawsze chce „zaraz to włączyć”.{%- else -%}Brat Oli. Ufa ludziom bardziej, niż powinien.{%- endif -%}</p></div>
    <div class="who"><img src="{{ 'blok94-zdzisiek.png' | asset_url }}" alt="Pan Zdzisiek" loading="lazy"><h3>Pan Zdzisiek</h3><span class="tag" style="background:#e07a7a">2. piętro</span><p>„Ja tu znam wszystkich.” I naprawdę pilnuje klatki.</p></div>
    <div class="who egg" id="b94-kaptur" tabindex="0" role="button" aria-label="Kaptur. Coś tu jest…"><img src="{{ 'blok94-kaptur.png' | asset_url }}" alt="Kaptur" loading="lazy"><h3>Kaptur</h3><span class="tag" style="background:#c9cdd2">{%- if section.settings.parts >= 4 -%}mieszkanie 104?{%- else -%}???{%- endif -%}</span><p>Nikt nie widział jego twarzy. Zna ten blok lepiej niż ktokolwiek.</p></div>
  </div>
</div></section>

<section class="rules" id="zasady"><div class="wrap">
  <span class="eyebrow">Z każdej części jedna zasada</span><h2 style="margin-top:12px">Zasady z bloku 94</h2>
  <ul class="rlist">
    <li><div class="peep" aria-hidden="true"></div><div><b>Ktoś puka w nocy, a wizjer jest czarny?</b><span>Nie pytaj „kto tam?”. Nie zdradzaj, że jesteś w domu. Dzwoń na <span class="n112">112</span>.</span></div></li>
    <li><div class="peep" aria-hidden="true"></div><div><b>Ktoś prosi o pomoc zza drzwi?</b><span>Nie otwieraj, nawet na łańcuch. Pomoc wezwiesz przez drzwi.</span></div></li>
    <li><div class="peep" aria-hidden="true"></div><div><b>Ktoś mówi, że jest z policji?</b><span>Zapytaj dyspozytora <span class="n112">112</span>, czy patrol jest pod twoim adresem.</span></div></li>
    {%- if section.settings.parts >= 3 -%}<li><div class="peep" aria-hidden="true"></div><div><b>Prąd zgasł tylko u ciebie?</b><span>Nie wychodź w nocy na korytarz do licznika.</span></div></li>{%- endif -%}
    {%- if section.settings.parts >= 4 -%}<li><div class="peep" aria-hidden="true"></div><div><b>Zgubione klucze z numerem mieszkania?</b><span>Zamek wymień tej samej nocy. Nie noś numeru na breloczku.</span></div></li>{%- endif -%}
    <li><div class="peep" aria-hidden="true"></div><div><b>Jesteś sam w domu?</b><span>Nie pisz o tym w relacji i nie dodawaj lokalizacji.</span></div></li>
  </ul>
  <div class="pdf"><a class="btn red" href="{{ 'blok94-zasady.pdf' | asset_url }}" download="Zasady-z-bloku-94.pdf" target="_blank" rel="noopener">⬇ Pobierz zasady (PDF)</a><p>Jedna strona do wydruku: na lodówkę, do klasy, na tablicę ogłoszeń w bloku. Za darmo.</p></div>
</div></section>

