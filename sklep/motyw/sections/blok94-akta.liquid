      {%- if P >= 6 -%}<details class="file"{% if P == 6 %} open{% endif %}><summary><span class="pt">Odc. 7 · 23:58 · 2. piętro</span><h3>Ktoś na balkonie</h3><span class="cnt"></span></summary><ul>
