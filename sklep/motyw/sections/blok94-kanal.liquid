{%- comment -%} BLOK 94 – Nasz kanał: liczby, droga do 1000, części serii, gra, zapowiedzi, tapety. {%- endcomment -%}
{{ 'blok94.css' | asset_url | stylesheet_tag }}
{%- assign fol = section.settings.followers | remove: ' ' | plus: 0 -%}
{%- assign pct = fol | times: 100 | divided_by: 1000 -%}{%- if pct > 100 -%}{%- assign pct = 100 -%}{%- endif -%}
<div class="b94p" id="b94k">
  <section class="hero"><span class="lamp" aria-hidden="true"></span><div class="wrap">
    <div class="rv">
      <span class="eyebrow">@protokolocaleni na TikToku</span>
      <h1 style="margin-top:14px">Rośniemy <span class="sign">razem z wami</span></h1>
      <p class="lead">Robimy animowaną serię „Kto tam?” o jednym bloku, nocy i prawdziwych zasadach bezpieczeństwa. Tu zobaczysz, ile nas już jest, co już wyszło i co szykujemy dalej.</p>
      <div class="cta"><a class="btn red" href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">Obserwuj na TikToku</a><a class="btn line" href="{{ section.settings.youtube }}" target="_blank" rel="noopener">Całe filmy na YouTube</a><a class="btn gold" href="{{ routes.root_url }}#wesprzyj">Wesprzyj kanał</a></div>
    </div>
    <div class="scene rv" aria-hidden="true">
      <div class="door94"></div>
      <img class="who" src="{{ 'blok94-zdzisiek.png' | asset_url }}" alt="" style="left:44%" loading="lazy">
      <img class="who b" src="{{ 'blok94-kaptur.png' | asset_url }}" alt="" style="left:70%;opacity:.9" loading="lazy">
      <span class="tag" style="left:44%;top:8%">„Ja tu znam wszystkich.”</span>
    </div>
  </div></section>

  <section class="band"><div class="wrap">
    <div class="rv"><span class="eyebrow">Kanał w liczbach</span><h2 style="margin-top:12px">Tyle nas już jest</h2></div>
    <div class="stats rv">
      <div class="stat"><b data-count>{{ section.settings.followers }}</b><span>obserwujących</span></div>
      <div class="stat"><b data-count>{{ section.settings.likes }}</b><span>polubień</span></div>
      <div class="stat"><b data-count>{{ section.settings.top }}</b><span>wyświetleń części 2</span></div>
      <div class="stat"><b data-count>{{ section.settings.videos }}</b><span>filmów na kanale</span></div>
    </div>
    <p class="note">Stan na {{ section.settings.stats_date }}.</p>
    <div class="road rv">
      <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:10px"><h3>Droga do 1000</h3><b style="font-family:var(--mono);color:var(--hat)">{{ section.settings.followers }} / 1000</b></div>
      <div class="bar"><i data-fill="{{ pct }}%"></i></div>
      <div class="ms">{%- for block in section.blocks -%}{%- if block.type == 'milestone' -%}<div class="m{% if fol >= block.settings.at %} done{% endif %}" {{ block.shopify_attributes }}><b>{{ block.settings.label | escape }}</b>{{ block.settings.reward | escape }}</div>{%- endif -%}{%- endfor -%}</div>
    </div>
  </div></section>

  <section id="seria"><div class="wrap">
    <div class="rv"><span class="eyebrow">Seria</span><h2 style="margin-top:12px">„Kto tam?”: oglądaj od początku</h2><p class="lead">Ola zostaje sama na noc w mieszkaniu 94. Każda część to jedna zasada, która może uratować także ciebie.</p></div>
    <div class="eps">
      <article class="ep rv"><img src="{{ 'blok94-czesc1.jpg' | asset_url }}" alt="Okładka części 1" loading="lazy" width="720" height="900"><div class="in"><span class="no">Część 1</span><h3>Nie pytaj „kto tam?”</h3><p>Ktoś zakleił wizjer. Za drzwiami płacze kobieta.</p><a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">Oglądaj →</a></div></article>
      {%- if section.settings.parts >= 2 -%}<article class="ep rv"><img src="{{ 'blok94-czesc2.jpg' | asset_url }}" alt="Okładka części 2" loading="lazy" width="720" height="900"><div class="in"><span class="no">Część 2</span><h3>Nie otwieraj „policji”!</h3><p>Ktoś wali do drzwi: „Policja!”. Prawdziwy patrol jest jeszcze daleko.</p><a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">Oglądaj →</a></div></article>{%- endif -%}
      {%- if section.settings.parts >= 3 -%}<article class="ep rv"><img src="{{ 'blok94-czesc3.jpg' | asset_url }}" alt="Okładka części 3" loading="lazy" width="720" height="900"><div class="in"><span class="no">Część 3</span><h3>Nie wychodź do licznika!</h3><p>O północy prąd gaśnie tylko w mieszkaniu 94.</p><a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">Oglądaj →</a></div></article>{%- endif -%}
      {%- if section.settings.parts >= 4 -%}<article class="ep rv"><img src="{{ 'blok94-czesc4.jpg' | asset_url }}" alt="Okładka części 4" loading="lazy" width="720" height="900"><div class="in"><span class="no">Część 4</span><h3>Nie czekaj do rana!</h3><p>O 3:12 zamek przekręca się sam.</p><a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">Oglądaj →</a></div></article>{%- endif -%}
      <article class="ep rv" style="background:linear-gradient(180deg,#2a1d14,#1b2034)"><div class="in" style="justify-content:center;min-height:260px"><span class="no">Gra</span><h3>Co zrobisz, gdy ktoś puka?</h3><p>Dwa tryby: „Kto tam?” i „Noc w bloku 94”. Zagraj w przeglądarce, bez instalowania.</p><a class="btn red" href="/pages/gra" style="margin-top:12px">Graj</a></div></article>
    </div>
  </div></section>

  {%- assign nb = blogs.aktualnosci -%}
  {%- if nb and nb.articles_count > 0 -%}
  <section class="band"><div class="wrap">
    <div class="rv"><span class="eyebrow">Zapowiedzi</span><h2 style="margin-top:12px">Co słychać na kanale</h2></div>
    <div class="news">{%- for a in nb.articles limit: 6 -%}{%- if a.title contains 'Kto tam' or a.tags contains 'blok94' -%}<a class="rv" href="{{ a.url }}"><small>{{ a.published_at | date: '%d.%m.%Y' }}</small><b>{{ a.title | escape }}</b><p>{{ a.excerpt_or_content | strip_html | truncatewords: 22 }}</p></a>{%- endif -%}{%- endfor -%}</div>
  </div></section>
  {%- endif -%}

  <section><div class="wrap">
    <div class="rv"><span class="eyebrow">Za darmo</span><h2 style="margin-top:12px">Tapety na telefon</h2><p class="lead">Kliknij, zapisz i ustaw jako tło. Bez logowania.</p></div>
    <div class="walls rv">
      <a href="{{ 'blok94-tapeta1.jpg' | asset_url }}" download target="_blank" rel="noopener"><img src="{{ 'blok94-tapeta1.jpg' | asset_url }}" alt="Tapeta: blok nocą i Kaptur" loading="lazy" width="1080" height="1920"><span>Blok nocą</span></a>
      <a href="{{ 'blok94-tapeta2.jpg' | asset_url }}" download target="_blank" rel="noopener"><img src="{{ 'blok94-tapeta2.jpg' | asset_url }}" alt="Tapeta: oczy w wizjerze" loading="lazy" width="1080" height="1920"><span>Oczy w wizjerze</span></a>
      <a href="{{ 'blok94-tapeta3.jpg' | asset_url }}" download target="_blank" rel="noopener"><img src="{{ 'blok94-tapeta3.jpg' | asset_url }}" alt="Tapeta: drzwi 94" loading="lazy" width="1080" height="1920"><span>Drzwi 94</span></a>
    </div>
  </div></section>

  <section class="band"><div class="wrap">
    <div class="rv"><span class="eyebrow">Za kulisami</span><h2 style="margin-top:12px">Jak powstaje jedna część</h2></div>
    <div class="steps">
      <div class="step rv"><h3>Scenariusz</h3><p>Prawdziwa sytuacja z życia i jedna zasada bezpieczeństwa, którą sprawdzamy w oficjalnych źródłach.</p></div>
      <div class="step rv"><h3>Animacja</h3><p>Kubę, Olę, Kaptura i cały blok rysujemy w kodzie. Każda część to ponad 3000 klatek.</p></div>
      <div class="step rv"><h3>Lektor i dźwięk</h3><p>Lektor, głosy postaci, pukanie, winda i bicie serca. Wszystko miksujemy sami.</p></div>
      <div class="step rv"><h3>Wasze teorie</h3><p>Czytamy komentarze. Kto mieszka w bloku 94? Część odpowiedzi trafia do kolejnych części.</p></div>
    </div>
    {%- if section.settings.show_archive -%}<p class="note" style="margin-top:24px">Wcześniej na kanale: seria „Co gdyby… Stadion”. Cały sezon znajdziesz na <a href="{{ section.settings.youtube }}" target="_blank" rel="noopener">YouTube</a>.</p>{%- endif -%}
  </div></section>
</div>
{%- render 'blok94-anim' -%}

{% schema %}
{"name":"BLOK 94 · Nasz kanał","settings":[
 {"type":"text","id":"followers","label":"Obserwujący","default":"899"},
 {"type":"text","id":"likes","label":"Polubienia","default":"8 700"},
 {"type":"text","id":"top","label":"Wyświetlenia części 2","default":"160 000"},
 {"type":"text","id":"videos","label":"Liczba filmów","default":"9"},
 {"type":"text","id":"stats_date","label":"Data statystyk","default":"7.11.2026"},
 {"type":"range","id":"parts","label":"Ile części serii pokazać","min":1,"max":4,"step":1,"default":2},
 {"type":"text","id":"tiktok","label":"TikTok","default":"https://www.tiktok.com/@protokolocaleni"},
 {"type":"text","id":"youtube","label":"YouTube","default":"https://youtube.com/@protokolocaleni"},
 {"type":"checkbox","id":"show_archive","label":"Pokaż wzmiankę o serii Stadion","default":true}
],"blocks":[{"type":"milestone","name":"Kamień milowy","settings":[{"type":"number","id":"at","label":"Liczba obserwujących","default":100},{"type":"text","id":"label","label":"Nazwa"},{"type":"text","id":"reward","label":"Nagroda"}]}],
"presets":[{"name":"BLOK 94 · Nasz kanał"}]}
{% endschema %}
