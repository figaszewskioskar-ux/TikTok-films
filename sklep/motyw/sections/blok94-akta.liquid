<script>
(function(){var r=document.getElementById('b94a');if(!r)return;
 r.querySelectorAll('details.file').forEach(function(d){var n=d.querySelectorAll('li').length,c=d.querySelector('.cnt');if(c)c.textContent=n+(n===1?' poszlaka':n<5?' poszlaki':' poszlak')+' · rozwiń';});
 var items=r.querySelectorAll('.file li[data-f]');
 function showFloor(f){var first=null;items.forEach(function(li){li.classList.remove('hit');if(li.getAttribute('data-f')===f){var dd=li.closest('details');if(dd)dd.open=true;void li.offsetWidth;li.classList.add('hit');if(!first)first=li;}});if(first)first.scrollIntoView({behavior:'smooth',block:'center'});}
 var A={};try{A=JSON.parse(document.getElementById('b94a-apts').textContent);}catch(e){}
 var card=document.getElementById('b94a-card'),apts=r.querySelectorAll('.apt[data-a]'),curF=null;
 apts.forEach(function(b){b.addEventListener('click',function(){var d=A[b.getAttribute('data-a')];if(!d)return;curF=b.getAttribute('data-f');
  apts.forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false');});
  document.getElementById('ac-pt').textContent=d.pt;document.getElementById('ac-h').textContent=d.h;document.getElementById('ac-p').textContent=d.p;
  card.hidden=false;card.style.animation='none';void card.offsetWidth;card.style.animation='';
  var hasItems=[].some.call(items,function(li){return li.getAttribute('data-f')===curF;});document.getElementById('ac-go').hidden=!hasItems;});});
 document.getElementById('ac-go').addEventListener('click',function(){if(curF!==null)showFloor(curF);});
 card.querySelector('.ax').addEventListener('click',function(){card.hidden=true;apts.forEach(function(x){x.setAttribute('aria-pressed','false');});});
 var fls=[];
 fls.forEach(function(b){b.addEventListener('click',function(){var f=b.getAttribute('data-f'),first=null;
  fls.forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false');});
  items.forEach(function(li){li.classList.remove('hit');if(li.getAttribute('data-f')===f){var dd=li.closest('details');if(dd)dd.open=true;void li.offsetWidth;li.classList.add('hit');if(!first)first=li;}});
  if(first)first.scrollIntoView({behavior:'smooth',block:'center'});});});
 var ob=r.querySelectorAll('#b94a-opts button'),res=document.getElementById('b94a-res'),code=document.getElementById('b94a-code'),K='b94-kaptur-typ';
 function pick(v,save){ob.forEach(function(x){x.setAttribute('aria-pressed',x.getAttribute('data-v')===v?'true':'false');});code.textContent='#AktaBlok94 TYPUJĘ: '+v;res.classList.add('on');if(save){try{localStorage.setItem(K,v);}catch(e){}}}
 ob.forEach(function(b){b.addEventListener('click',function(){pick(b.getAttribute('data-v'),true);});});
 try{var s=localStorage.getItem(K);if(s)pick(s,false);}catch(e){}
 document.getElementById('b94a-copy').addEventListener('click',function(e){var t=code.textContent,btn=e.currentTarget;
  function ok(){btn.textContent='Skopiowano ✓';setTimeout(function(){btn.textContent='Kopiuj komentarz';},1800);}
  if(navigator.clipboard)navigator.clipboard.writeText(t).then(ok,function(){});else{var a=document.createElement('textarea');a.value=t;document.body.appendChild(a);a.select();try{document.execCommand('copy');ok();}catch(_){}a.remove();}});
})();
</script>
