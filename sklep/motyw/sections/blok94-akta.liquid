{%- comment -%}
  BLOK 94 – „Akta sprawy”: przekrój bloku z poszlakami. Poszlaki z części, które jeszcze nie wyszły,
  nie trafiają do HTML (ustawienie „Ile części wyszło”). Typowanie „Kto jest Kapturem?” zapisuje się tylko u widza.
{%- endcomment -%}
{%- assign P = section.settings.parts -%}
<style>
#b94a{--night:#0a0c14;--stair:#131726;--wall:#1b2034;--ink:#f3efe6;--muted:#aeb0c2;--sign:#d7263d;--hat:#f39c12;--gold:#c9a15a;--paper:#efe6cf;--paper2:#e3d7b8;
 --display:"Big Shoulders Display","Arial Narrow",Impact,sans-serif;--body:"Public Sans",system-ui,-apple-system,"Segoe UI",sans-serif;--mono:"JetBrains Mono",ui-monospace,"Courier New",monospace;
 background:radial-gradient(900px 500px at 70% -5%,#1d2747 0%,var(--night) 60%);color:var(--ink);font-family:var(--body);font-size:17px;line-height:1.55;padding-block:32px 72px}
#b94a *{box-sizing:border-box}#b94a img{max-width:100%;display:block}#b94a a{color:inherit}
#b94a .wrap{max-width:1120px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
#b94a h1,#b94a h2,#b94a h3{font-family:var(--display);font-weight:800;line-height:1.02;margin:0;text-wrap:balance}
#b94a h1{font-size:clamp(48px,11vw,96px);margin:14px 0 10px}#b94a h2{font-size:clamp(30px,6vw,44px)}
#b94a .eyebrow{display:inline-block;font:800 12px/1 var(--body);letter-spacing:.14em;text-transform:uppercase;color:#14161b;background:var(--hat);padding:7px 12px;border-radius:999px}
#b94a .sign{display:inline-block;background:var(--sign);color:#fff;padding:.04em .28em .1em;border-radius:.18em;transform:rotate(-1.5deg)}
#b94a .lead{color:var(--muted);max-width:60ch;margin:0}
#b94a .stamp{display:inline-block;border:3px solid var(--sign);color:#ff6b7a;font:900 13px/1 var(--body);letter-spacing:.2em;padding:7px 10px;transform:rotate(-4deg);margin-left:10px;vertical-align:middle}
#b94a .lay{display:grid;gap:28px;margin-top:30px;grid-template-columns:minmax(0,1fr)}
@media(min-width:900px){#b94a .lay{grid-template-columns:360px minmax(0,1fr);align-items:start}#b94a .blk{position:sticky;top:110px}}
/* przekrój bloku */
#b94a .blk{background:#0d1020;border-radius:20px;padding:16px 14px 0;box-shadow:inset 0 0 0 2px rgba(255,255,255,.06)}
#b94a .blk .roof{height:14px;background:#2a3150;border-radius:6px 6px 0 0;margin:0 8px}
#b94a .fl{all:unset;box-sizing:border-box;display:grid;grid-template-columns:44px 1fr auto;align-items:center;gap:10px;width:100%;min-height:46px;padding:6px 12px;background:#1a1f35;border-bottom:2px solid #0d1020;cursor:pointer;position:relative}
#b94a .fl .no{font:800 13px/1 var(--mono);color:var(--muted)}
#b94a .fl .win{display:flex;gap:6px}#b94a .fl .win i{width:16px;height:20px;border-radius:2px;background:#0b0e1a;box-shadow:inset 0 0 0 2px #2a3150}
#b94a .fl .win i.on{background:#f5c542;box-shadow:0 0 12px rgba(245,197,66,.6)}
#b94a .fl .tag{font:800 12px/1.1 var(--body);background:var(--sign);color:#fff;padding:6px 8px;border-radius:8px;text-align:right;max-width:150px}
#b94a .fl .tag.q{background:#2a3150;color:var(--muted)}
#b94a .fl:hover,#b94a .fl[aria-pressed=true]{background:#262d4d}#b94a .fl[aria-pressed=true]{box-shadow:inset 4px 0 0 var(--hat)}
#b94a .fl:focus-visible{outline:3px solid var(--hat);outline-offset:-3px}
#b94a .fl.quiet{cursor:default}#b94a .fl.quiet:hover{background:#1a1f35}
#b94a .ground{height:18px;background:repeating-linear-gradient(90deg,#2b2218 0 18px,#231b13 18px 36px);margin:0 -14px;border-radius:0 0 20px 20px}
#b94a .hint{font-size:13px;color:var(--muted);margin:10px 4px 12px}
/* akta: kartki */
#b94a .files{display:grid;gap:18px}
#b94a .file{background:linear-gradient(180deg,var(--paper),var(--paper2));color:#1d1a14;border-radius:6px 16px 16px 16px;padding:18px 18px 16px;position:relative;box-shadow:0 18px 40px rgba(0,0,0,.45)}
#b94a .file:before{content:"";position:absolute;top:-14px;left:0;width:120px;height:16px;background:var(--paper);border-radius:8px 8px 0 0}
#b94a .file h3{font-size:26px;color:#1d1a14}#b94a .file .pt{font:800 12px/1 var(--mono);letter-spacing:.08em;color:#8a2a1a;text-transform:uppercase}
#b94a .file ul{list-style:none;margin:12px 0 0;padding:0;display:grid;gap:10px}
#b94a .file li{display:grid;grid-template-columns:30px 1fr;gap:10px;align-items:start;font-size:16px;line-height:1.45}
#b94a .file li .ic{width:30px;height:30px;border-radius:50%;background:#1d1a14;color:var(--hat);display:flex;align-items:center;justify-content:center;font-size:15px}
#b94a .file li b{font-weight:800}
#b94a .file li.hit{animation:b94aHit 1.6s ease}
@keyframes b94aHit{0%,100%{background:transparent}20%,60%{background:rgba(215,38,61,.18)}}
#b94a .file .fl-ref{font:700 11px/1 var(--mono);color:#6b5f45;margin-top:4px;display:block}
#b94a .locked{background:repeating-linear-gradient(45deg,#151a2e 0 14px,#11152a 14px 28px);border-radius:16px;padding:18px;text-align:center;color:var(--muted);font-weight:700}
#b94a .locked b{display:block;font-family:var(--display);font-size:28px;color:var(--ink)}
/* typowanie */
#b94a .vote{margin-top:44px;background:var(--wall);border-radius:22px;padding:22px}
#b94a .opts{display:grid;gap:10px;margin-top:16px}
@media(min-width:700px){#b94a .opts{grid-template-columns:1fr 1fr}}
#b94a .opts button{all:unset;box-sizing:border-box;cursor:pointer;background:#0f1220;border-radius:14px;padding:14px 16px;font-weight:700;box-shadow:inset 0 0 0 2px rgba(255,255,255,.08)}
#b94a .opts button small{display:block;font-weight:500;color:var(--muted);font-size:14px;margin-top:4px}
#b94a .opts button[aria-pressed=true]{box-shadow:inset 0 0 0 3px var(--hat);background:#1d1a10}
#b94a .opts button:focus-visible{outline:3px solid var(--hat);outline-offset:2px}
#b94a .res{margin-top:16px;display:none;background:#0f1220;border-radius:14px;padding:16px}
#b94a .res.on{display:block}#b94a .res code{font:800 18px/1.3 var(--mono);color:#f5c542;display:block;margin:8px 0}
#b94a .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 18px;border-radius:14px;font:800 15px/1 var(--body);text-decoration:none;border:0;cursor:pointer}
#b94a .btn.red{background:var(--sign);color:#fff}#b94a .btn.line{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 2px rgba(243,239,230,.35)}
#b94a .row{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}
#b94a .end{margin-top:44px;display:grid;gap:18px}
@media(min-width:900px){#b94a .end{grid-template-columns:1fr 1fr;align-items:start}}
#b94a .end .box{background:var(--wall);border-radius:22px;padding:22px}
#b94a .end .box .b94n{margin-top:12px}
</style>

{%- capture ic_eye -%}<span class="ic" aria-hidden="true">👁</span>{%- endcapture -%}
<div id="b94a"><div class="wrap">
  <span class="eyebrow">Śledztwo · odcinki 2–{{ P | plus: 1 }}</span>
  <h1>Akta sprawy <span class="sign">Kaptur</span></h1>
  <p class="lead">Wszystko, co wiemy o Kapturze, piętro po piętrze. Kliknij piętro w bloku, a pokażemy poszlaki, które się z nim łączą. Po każdej nowej części akta się powiększają.</p>

  <div class="lay">
    <div class="blk" aria-label="Przekrój bloku 94">
      <p class="hint" style="margin-top:0">Kasztanowa 12 · klatka II</p>
      <div class="roof" aria-hidden="true"></div>
      {%- comment -%} piętra od 10 do parteru {%- endcomment -%}
      {%- if P >= 4 -%}<button class="fl" data-f="10" aria-pressed="false"><span class="no">10 p.</span><span class="win" aria-hidden="true"><i></i><i></i><i class="on"></i><i></i></span><span class="tag">104 · nad pokojem Oli</span></button>
      {%- else -%}<div class="fl quiet"><span class="no">10 p.</span><span class="win" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="tag q">?</span></div>{%- endif -%}
      <button class="fl" data-f="9" aria-pressed="false"><span class="no">9 p.</span><span class="win" aria-hidden="true"><i></i><i></i><i class="on"></i><i></i></span><span class="tag">94 · Ola{% if P >= 3 %} i Kuba{% endif %}</span></button>
      {%- for f in (4..8) reversed -%}<div class="fl quiet"><span class="no">{{ f }} p.</span><span class="win" aria-hidden="true"><i></i><i{% if f == 6 %} class="on"{% endif %}></i><i></i><i></i></span><span></span></div>{%- endfor -%}
      {%- if P >= 2 -%}<button class="fl" data-f="3" aria-pressed="false"><span class="no">3 p.</span><span class="win" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="tag">tu złapano kobietę</span></button>
      {%- else -%}<div class="fl quiet"><span class="no">3 p.</span><span class="win" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span></span></div>{%- endif -%}
      <button class="fl" data-f="2" aria-pressed="false"><span class="no">2 p.</span><span class="win" aria-hidden="true"><i class="on"></i><i></i><i></i><i></i></span><span class="tag">{% if P >= 5 %}22 · {% endif %}pan Zdzisiek</span></button>
      <div class="fl quiet"><span class="no">1 p.</span><span class="win" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span></span></div>
      <button class="fl" data-f="0" aria-pressed="false"><span class="no">parter</span><span class="win" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="tag">7 · okradziona sąsiadka</span></button>
      <div class="ground" aria-hidden="true"></div>
    </div>

    <div class="files">
      <article class="file"><span class="pt">Odcinek 2 · 2:47 · 9. piętro</span><h3>Zaklejony wizjer</h3><ul>
        <li data-f="9">{{ ic_eye }}<div><b>Wizjer zaklejony od zewnątrz.</b> Światło na klatce paliło się całą noc, a w wizjerze było czarno.<span class="fl-ref">9 p. · drzwi 94</span></div></li>
        <li data-f="9"><span class="ic" aria-hidden="true">😢</span><div><b>Płacz był przynętą.</b> Kobieta stała przy ścianie obok drzwi, tam, gdzie wizjer nie sięga. Kaptur czekał piętro wyżej.<span class="fl-ref">9 p. · klatka</span></div></li>
        <li data-f="9"><span class="ic" aria-hidden="true">🧤</span><div><b>Ręka w czarnej rękawiczce</b> sięgała do łańcucha, gdy Ola uchyliła drzwi.</div></li>
        <li data-f="0"><span class="ic" aria-hidden="true">📺</span><div><b>Tydzień wcześniej, pod siódemką:</b> ten sam płacz. Rano sąsiadka z mieszkania 7 nie miała telewizora ani obrączki.<span class="fl-ref">parter · mieszkanie 7</span></div></li>
        <li data-f="2"><span class="ic" aria-hidden="true">🔦</span><div><b>Świadek: pan Zdzisiek.</b> On już kiedyś słyszał ten płacz.<span class="fl-ref">2 p.</span></div></li>
        <li data-f="9"><span class="ic" aria-hidden="true">✉</span><div><b>Kartka pod drzwiami</b> i taśma odklejona z wizjera. „Wiem, że patrzysz.”</div></li>
      </ul></article>

      {%- if P >= 2 -%}<article class="file"><span class="pt">Odcinek 3 · ta sama noc</span><h3>Fałszywa policja</h3><ul>
        <li data-f="9"><span class="ic" aria-hidden="true">🚨</span><div><b>„Policja! Otwierać!”</b> A prawdziwy patrol był jeszcze cztery minuty drogi od bloku. Klamka poszła w dół.</div></li>
        <li data-f="3"><span class="ic" aria-hidden="true">🚔</span><div><b>Kobietę złapano na 3. piętrze.</b> Kaptur zniknął, jakby znał ten blok lepiej niż ktokolwiek.<span class="fl-ref">3 p.</span></div></li>
        <li data-f="9"><span class="ic" aria-hidden="true">📱</span><div><b>Relacja Oli o 22:13:</b> „Sama na chacie do rana”, widok z okna i lokalizacja. 40 wyświetleń, w tym jedno konto bez zdjęcia.</div></li>
      </ul></article>{%- endif -%}

      {%- if P >= 3 -%}<article class="file"><span class="pt">Odcinek 4 · 23:58</span><h3>Prąd tylko w 94</h3><ul>
        <li data-f="9"><span class="ic" aria-hidden="true">📷</span><div><b>Konto k4ptur_94</b> przysłało zdjęcie drzwi 94 z nowym zamkiem, zrobione z klatki tego samego dnia.</div></li>
        <li data-f="9"><span class="ic" aria-hidden="true">⚡</span><div><b>Skrzynka z licznikami na korytarzu nie była zamknięta.</b> Bezpiecznik 94 ktoś wyłączył ręcznie.<span class="fl-ref">9 p. · korytarz</span></div></li>
        <li data-f="9"><span class="ic" aria-hidden="true">🔑</span><div><b>Klucze Kuby z breloczkiem „94”</b> wypadły przy skrzynce. Teraz ma je Kaptur.</div></li>
      </ul></article>{%- endif -%}

      {%- if P >= 4 -%}<article class="file"><span class="pt">Odcinek 5 · 3:12</span><h3>Klucz pasuje</h3><ul>
        <li data-f="9"><span class="ic" aria-hidden="true">🔓</span><div><b>Oba zamki puściły.</b> Uratował ich łańcuch i Kuba dociskający drzwi barkiem.</div></li>
        <li data-f="2"><span class="ic" aria-hidden="true">🔦</span><div><b>Pan Zdzisiek od dwóch nocy pilnował klatki.</b> „Ja tu znam wszystkich. Ciebie też poznam!”<span class="fl-ref">2 p. → 9 p.</span></div></li>
        <li data-f="10"><span class="ic" aria-hidden="true">⬆</span><div><b>Kaptur nie uciekł na dół, tylko w górę.</b> Drzwi 104 zamknęły się cicho: mieszkanie dokładnie nad pokojem Oli.<span class="fl-ref">10 p. · mieszkanie 104</span></div></li>
        <li data-f="10"><span class="ic" aria-hidden="true">👊</span><div><b>W nocy pukanie z sufitu.</b> „Dobranoc, sąsiadko.”</div></li>
      </ul></article>{%- endif -%}

      {%- if P >= 5 -%}<article class="file"><span class="pt">Odcinek 6 · następnego dnia</span><h3>Nowy sąsiad</h3><ul>
        <li data-f="9"><span class="ic" aria-hidden="true">🪛</span><div><b>„Nowy z 104”</b> pożyczył śrubokręt i dowiedział się, że rodzice pracują na noce, od poniedziałku do czwartku. Kuba wpuścił go do środka.</div></li>
        <li data-f="10"><span class="ic" aria-hidden="true">🏚</span><div><b>W 104 nikt nie mieszka od pół roku.</b> Właściciel jest w Norwegii.<span class="fl-ref">10 p.</span></div></li>
        <li data-f="10"><span class="ic" aria-hidden="true">🖼</span><div><b>Ściana zdjęć:</b> drzwi z całego bloku, pod każdym notatka. Ostatnie zdjęcie: drzwi 22. Podpis: „sam”.</div></li>
      </ul></article>{%- endif -%}

      {%- if P >= 6 -%}<article class="file"><span class="pt">Odcinek 7 · 23:58 · 2. piętro</span><h3>Ktoś na balkonie</h3><ul>
        <li data-f="2"><span class="ic" aria-hidden="true">🪟</span><div><b>Uchylony balkon u pana Zdziśka.</b> Ktoś stał tuż za szybą. Na parapecie kartka: „Nie ciebie szukałem.”</div></li>
        <li data-f="9"><span class="ic" aria-hidden="true">🚪</span><div><b>Ola i Kuba wybiegli na pomoc i zostawili otwarte drzwi.</b> Po powrocie: karteczka na szybie od środka i uchylona szafa.</div></li>
      </ul></article>{%- endif -%}

      {%- if P >= 7 -%}<article class="file"><span class="pt">Odcinek 8 · ta sama noc</span><h3>Kamera w szafie</h3><ul>
        <li data-f="9"><span class="ic" aria-hidden="true">🎥</span><div><b>W szafie kamera skierowana na łóżko Oli,</b> połączona z kontem Kuby.</div></li>
        <li data-f="9"><span class="ic" aria-hidden="true">🔐</span><div><b>Jedno hasło do wszystkiego: kuba94.</b> Stąd wiedział o kluczach, o relacji i o grafiku rodziców.</div></li>
        <li data-f="9"><span class="ic" aria-hidden="true">💻</span><div><b>Kamerka w laptopie zapaliła się sama.</b> „Za późno, Kuba.”</div></li>
      </ul></article>{%- endif -%}

      <div class="locked"><b>Odcinek {{ P | plus: 2 }} · akta zamknięte</b>Nowe poszlaki pojawią się tu w dniu premiery.</div>
    </div>
  </div>

  <section class="vote" aria-labelledby="b94a-v"><span class="eyebrow">Twoja teoria</span><h2 id="b94a-v" style="margin-top:12px">Kto jest Kapturem?</h2>
    <p class="lead" style="margin-top:8px">Wybierz typ. Zapisze się tylko w twoim telefonie. Potem wrzuć go do komentarza pod najnowszą częścią, a po finale sprawdzimy, kto miał rację.</p>
    <div class="opts" id="b94a-opts">
      <button type="button" data-v="KTOŚ Z BLOKU" aria-pressed="false">Ktoś z bloku 94<small>Zna każde piętro, skrzynkę z licznikami i drogę ucieczki.</small></button>
      <button type="button" data-v="KTOŚ Z RELACJI" aria-pressed="false">Ktoś, kto ogląda relacje Oli<small>Wiedział, że jest sama. 39 osób Ola zna…</small></button>
      <button type="button" data-v="WSPÓLNIK KOBIETY" aria-pressed="false">Wspólnik kobiety z płaczem<small>Ona została złapana. On zniknął.</small></button>
      <button type="button" data-v="KTOŚ NOWY" aria-pressed="false">Ktoś, kogo jeszcze nie poznaliśmy<small>Prawdziwy Kaptur jeszcze się nie pokazał.</small></button>
    </div>
    <div class="res" id="b94a-res" aria-live="polite"><b>Twój typ jest zapisany.</b> Wpisz to w komentarzu pod najnowszą częścią:<code id="b94a-code"></code>
      <div class="row"><button type="button" class="btn red" id="b94a-copy">Kopiuj komentarz</button><a class="btn line" href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">Otwórz TikToka</a></div></div>
  </section>

  <div class="end">
    <div class="box"><span class="eyebrow">Nie przegap</span><h2 style="margin-top:12px">Nowe akta po każdej premierze</h2>
      {% render 'blok94-powiadom', id: 'akta' %}</div>
    <div class="box"><span class="eyebrow">Do wydruku</span><h2 style="margin-top:12px">Zasady z bloku 94</h2>
      <p class="lead" style="margin-top:8px">Wszystkie zasady z serii na jednej stronie A4. Dla domu, klasy i tablicy ogłoszeń w bloku.</p>
      <div class="row"><a class="btn red" href="{{ 'blok94-zasady.pdf' | asset_url }}" download="Zasady-z-bloku-94.pdf" target="_blank" rel="noopener">⬇ Pobierz PDF</a><a class="btn line" href="/pages/gra">Sprawdź się w grze</a></div></div>
  </div>
</div></div>
<script>
(function(){var r=document.getElementById('b94a');if(!r)return;
 var fls=r.querySelectorAll('.fl[data-f]'),items=r.querySelectorAll('.file li[data-f]');
 fls.forEach(function(b){b.addEventListener('click',function(){var f=b.getAttribute('data-f'),first=null;
  fls.forEach(function(x){x.setAttribute('aria-pressed',x===b?'true':'false');});
  items.forEach(function(li){li.classList.remove('hit');if(li.getAttribute('data-f')===f){void li.offsetWidth;li.classList.add('hit');if(!first)first=li;}});
  if(first)first.scrollIntoView({behavior:'smooth',block:'center'});});});
 var ob=r.querySelectorAll('#b94a-opts button'),res=document.getElementById('b94a-res'),code=document.getElementById('b94a-code'),K='b94-kaptur-typ';
 function pick(v,save){ob.forEach(function(x){x.setAttribute('aria-pressed',x.getAttribute('data-v')===v?'true':'false');});code.textContent='#AktaBlok94 TYPUJĘ: '+v;res.classList.add('on');if(save){try{localStorage.setItem(K,v);}catch(e){}}}
 ob.forEach(function(b){b.addEventListener('click',function(){pick(b.getAttribute('data-v'),true);});});
 try{var s=localStorage.getItem(K);if(s)pick(s,false);}catch(e){}
 document.getElementById('b94a-copy').addEventListener('click',function(e){var t=code.textContent,btn=e.currentTarget;
  function ok(){btn.textContent='Skopiowano ✓';setTimeout(function(){btn.textContent='Kopiuj komentarz';},1800);}
  if(navigator.clipboard)navigator.clipboard.writeText(t).then(ok,function(){});else{var a=document.createElement('textarea');a.value=t;document.body.appendChild(a);a.select();try{document.execCommand('copy');ok();}catch(_){}a.remove();}});
})();
</script>
