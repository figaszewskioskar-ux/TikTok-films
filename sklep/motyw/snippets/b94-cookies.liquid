{%- comment -%}
  Własny baner cookies w stylu BLOK 94. Zastępuje domyślny baner Shopify (ukryty CSS-em),
  a zgody zapisuje przez Shopify Customer Privacy API (setTrackingConsent) — tak samo jak baner Shopify.
  „Tylko niezbędne” jest tak samo łatwe jak „Akceptuję” (wymóg RODO). Test: dodaj ?cookies=1 do adresu.
{%- endcomment -%}
<style>
#shopify-pc__banner,#shopify-pc__prefs,.shopify-pc__banner__dialog{display:none!important}
#b94ck{position:fixed;left:12px;right:12px;bottom:12px;z-index:2147483000;max-width:560px;margin:0 auto;display:none;font-family:inherit}
#b94ck.on{display:block;animation:b94ckIn .45s cubic-bezier(.2,.9,.25,1.2)}
@keyframes b94ckIn{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
#b94ck .ck{position:relative;background:linear-gradient(180deg,#14161d,#0b0c11);color:#e9e6dc;border:1px solid rgba(255,255,255,.08);border-radius:22px;padding:20px 20px 16px;box-shadow:0 20px 60px rgba(0,0,0,.7),0 0 0 1px rgba(215,38,61,.15);overflow:hidden}
#b94ck .ck:before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:repeating-linear-gradient(-45deg,#f5c542 0 14px,#14161d 14px 28px);opacity:.9}
#b94ck .hd{display:flex;gap:14px;align-items:center;margin:6px 0 10px}
#b94ck .eye{flex:0 0 52px;height:52px;border-radius:50%;background:radial-gradient(circle at 50% 50%,#f4f1e8 0 34%,#0b0c11 35% 47%,#f4f1e8 48% 60%,#2a2d36 61%);box-shadow:0 0 22px rgba(244,241,232,.25);position:relative}
#b94ck .eye:after{content:"";position:absolute;left:50%;top:50%;width:8px;height:8px;margin:-4px;border-radius:50%;background:#000;animation:b94look 4s infinite}
@keyframes b94look{0%,100%{transform:translate(0,0)}30%{transform:translate(-5px,1px)}60%{transform:translate(5px,-1px)}}
#b94ck .tag{font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#f5c542;font-weight:800}
#b94ck h3{margin:2px 0 0;font-size:20px;line-height:1.15;font-weight:900;color:#fff}
#b94ck p{margin:0 0 12px;font-size:14px;line-height:1.45;color:#b9b6ad}
#b94ck p a{color:#f5c542}
#b94ck .bt{display:grid;grid-template-columns:1fr 1fr;gap:8px}
#b94ck button{all:unset;box-sizing:border-box;cursor:pointer;text-align:center;font-weight:900;font-size:14px;letter-spacing:.06em;text-transform:uppercase;padding:14px 10px;border-radius:14px;transition:transform .12s}
#b94ck button:active{transform:scale(.97)}
#b94ck button:focus-visible{outline:3px solid #f5c542;outline-offset:2px}
#b94ck .yes{background:#d7263d;color:#fff;box-shadow:0 6px 20px rgba(215,38,61,.35)}
#b94ck .no{background:#efe9da;color:#14161d}
#b94ck .more{grid-column:1/-1;background:transparent;color:#9aa2ab;font-size:12px;padding:8px;text-decoration:underline}
#b94ck .opts{display:none;margin:4px 0 12px;border-top:1px solid rgba(255,255,255,.08);padding-top:10px}
#b94ck.set .opts{display:block}
#b94ck label{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:9px 0;border-bottom:1px solid rgba(255,255,255,.06);font-size:14px}
#b94ck label small{display:block;color:#8a8f98;font-size:12px;margin-top:2px}
#b94ck input[type=checkbox]{appearance:none;flex:0 0 46px;height:26px;border-radius:13px;background:#2a2d36;position:relative;cursor:pointer;transition:background .2s}
#b94ck input[type=checkbox]:before{content:"";position:absolute;top:3px;left:3px;width:20px;height:20px;border-radius:50%;background:#e9e6dc;transition:transform .2s}
#b94ck input[type=checkbox]:checked{background:#30a46c}
#b94ck input[type=checkbox]:checked:before{transform:translateX(20px)}
#b94ck input[type=checkbox]:disabled{opacity:.6}
#b94ck .save{display:none;grid-column:1/-1;background:#f5c542;color:#14161d}
#b94ck.set .save{display:block}
#b94ck.set .more{display:none}
.b94ck-link{all:unset;cursor:pointer;color:inherit;text-decoration:underline;font-size:inherit}
</style>
<div id="b94ck" role="dialog" aria-modal="false" aria-labelledby="b94ck-t">
  <div class="ck">
    <div class="hd"><span class="eye" aria-hidden="true"></span><div><span class="tag">Klatka II · ciasteczka</span><h3 id="b94ck-t">W bloku 94 zawsze ktoś patrzy… 👁️</h3></div></div>
    <p>Ale tu decydujesz Ty. Pliki cookies pomagają nam prowadzić sklep i koszyk, sprawdzać, które gry i filmy lubicie najbardziej, oraz pokazywać nasze filmy na TikToku. <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Polityka prywatności</a></p>
    <div class="opts">
      <label>Niezbędne<small>Działanie strony, koszyk, bezpieczeństwo. Zawsze włączone.</small><input type="checkbox" checked disabled></label>
      <label>Statystyki<small>Które gry i filmy są popularne (anonimowo).</small><input type="checkbox" id="b94ck-a"></label>
      <label>Marketing<small>Reklamy naszych filmów, np. na TikToku.</small><input type="checkbox" id="b94ck-m"></label>
      <label>Preferencje<small>Zapamiętanie Twoich ustawień.</small><input type="checkbox" id="b94ck-p"></label>
    </div>
    <div class="bt">
      <button type="button" class="yes" id="b94ck-yes">Akceptuję</button>
      <button type="button" class="no" id="b94ck-no">Tylko niezbędne</button>
      <button type="button" class="save" id="b94ck-save">Zapisz wybór</button>
      <button type="button" class="more" id="b94ck-more">Ustawienia</button>
    </div>
  </div>
</div>
<script>
(function(){
  var box=document.getElementById('b94ck');if(!box)return;var KEY='b94-cookies';
  // powitanie (dialog modalny) czeka, aż użytkownik wybierze cookies
  var held=null, mo=null;
  function holdWelcome(){ var d=document.getElementById('b94-witaj'); if(!d)return; var grab=function(){ if(d.open&&box.classList.contains('on')){ held=d; try{d.close();}catch(e){d.removeAttribute('open');} } };
    grab(); if(!mo){ mo=new MutationObserver(grab); mo.observe(d,{attributes:true,attributeFilter:['open']}); } }
  function releaseWelcome(){ if(mo){mo.disconnect();mo=null;} if(held){ var d=held; held=null; setTimeout(function(){ try{d.showModal();}catch(e){d.setAttribute('open','');} },400); } }
  function show(){box.classList.add('on'); holdWelcome();}
  function hide(){box.classList.remove('on');box.classList.remove('set'); releaseWelcome();}
  function save(c){ try{localStorage.setItem(KEY,JSON.stringify(c));}catch(e){}
    var api=window.Shopify&&window.Shopify.customerPrivacy;
    if(api&&api.setTrackingConsent){ api.setTrackingConsent({analytics:c.a,marketing:c.m,preferences:c.p,sale_of_data:c.m},function(){}); }
    hide(); }
  document.getElementById('b94ck-yes').onclick=function(){save({a:true,m:true,p:true});};
  document.getElementById('b94ck-no').onclick=function(){save({a:false,m:false,p:false});};
  document.getElementById('b94ck-more').onclick=function(){box.classList.add('set');};
  document.getElementById('b94ck-save').onclick=function(){save({a:document.getElementById('b94ck-a').checked,m:document.getElementById('b94ck-m').checked,p:document.getElementById('b94ck-p').checked});};
  window.b94Cookies=function(){box.classList.add('set');show();};
  var force=/[?&]cookies=1/.test(location.search), stored=null; try{stored=localStorage.getItem(KEY);}catch(e){}
  function decide(){ var api=window.Shopify&&window.Shopify.customerPrivacy;
    if(force){show();return;}
    if(api&&api.shouldShowBanner){ if(api.shouldShowBanner())show(); return; }
    if(!stored)show(); }
  if(window.Shopify&&window.Shopify.loadFeatures){ window.Shopify.loadFeatures([{name:'consent-tracking-api',version:'0.1'}],function(err){decide();}); }
  else { decide(); }
})();
</script>
