.b94-akta .akta-vid{position:relative;margin-bottom:12px;border-radius:14px;overflow:hidden;background:#000;border:2px solid #d7263d}
.b94-akta .akta-vid video{display:block;width:100%;aspect-ratio:9/16;max-height:62vh;object-fit:contain;background:#000}
.b94-akta .akta-tag{position:absolute;z-index:2;top:10px;left:10px;background:#d7263d;color:#fff;font:900 12px/1 "Public Sans",sans-serif;letter-spacing:.12em;padding:7px 10px;border-radius:8px;pointer-events:none}
.b94-akta{max-height:calc(100vh - 32px);overflow:auto}
