{%- comment -%} Animacje podstron BLOK 94: pojawianie się przy przewijaniu, liczniki LED, pasek do 1000. {%- endcomment -%}
<script>
(function () {
  document.querySelectorAll('.b94p').forEach(function (root) {
    if (root.dataset.anim) return; root.dataset.anim = '1';
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!('IntersectionObserver' in window) || reduce) { root.querySelectorAll('[data-fill]').forEach(function (b) { b.style.width = b.getAttribute('data-fill'); }); return; }
    root.classList.add('js');
    function countUp(el) {
      var raw = el.textContent.trim(), num = parseFloat(raw.replace(/\s/g, '').replace(',', '.'));
      if (isNaN(num)) return; var t0 = null, dur = 1200, dec = /[.,]\d/.test(raw);
      function f(t) { if (!t0) t0 = t; var p = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - p, 3), v = num * e;
        el.textContent = raw.replace(/[\d\s.,]+[\d]/, dec ? v.toFixed(1).replace('.', ',') : Math.round(v).toLocaleString('pl-PL').replace(/ /g, ' '));
        if (p < 1) requestAnimationFrame(f); else el.textContent = raw; }
      requestAnimationFrame(f);
    }
    var io = new IntersectionObserver(function (es) {
      es.forEach(function (e) { if (!e.isIntersecting) return; var el = e.target; el.classList.add('in');
        el.querySelectorAll('[data-count]').forEach(countUp); if (el.hasAttribute('data-count')) countUp(el);
        el.querySelectorAll('[data-fill]').forEach(function (b) { b.style.width = b.getAttribute('data-fill'); });
        io.unobserve(el); });
    }, { threshold: .15 });
    root.querySelectorAll('.rv').forEach(function (e) { io.observe(e); });
  });
})();
</script>
